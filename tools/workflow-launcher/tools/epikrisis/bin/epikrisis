#!/usr/bin/env python3
"""epikrisis -- read a history, produce evidence, check a report against it.

Stages 1-4 and 6 are here and are programs. Stage 5, the report, is not: this
assembles the prompt and checks what comes back, and never writes the narrative.
See docs/design.md for why the split is where it is.

    epikrisis subjects
    epikrisis detectors
    epikrisis pin     <subject> --from <dir>
    epikrisis events  <subject>
    epikrisis record  <subject>
    epikrisis delta   <subject>
    epikrisis prompt  <subject>
    epikrisis check   <subject>
    epikrisis ratio   <subject>
    epikrisis selftest          -- prove `check` and `budget` can fail
    epikrisis budget            -- what the implementation is allowed to become

Stdlib only. No network: `pin` is pointed at mirrors somebody already has, and
the derivation path runs `git` and nothing else -- see `budget`.
"""

import argparse
import ast
import signal
import hashlib
import json
import os
import re
import statistics
import subprocess
import sys
from collections import defaultdict
from datetime import date, timedelta

TOOL_VERSION = "0.1.0-demo"
HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

# Thresholds that cannot be expressed relative to the subject. Every one of
# these is printed in the report header; see docs/events.md on why that matters.
DEFAULT_THRESHOLDS = {
    "prefix_depth": 1,          # a prefix is this many path components
    "min_commits_prefix": 3,    # commits under a prefix before birth/death fire
    "transplant_min_files": 3,  # renames in one commit to count as a move
    "rewrite_window_days": 7,
    "rewrite_churn_ratio": 1.0,  # churn in the window vs size at its start
    "governance_lines": 40,     # changed lines to count as a substantial revision
    "quiet_median_multiple": 6.0,
    "quiet_min_days": 3,        # floor, so a fast subject does not fire hourly
    "hands_window_days": 14,
    "delta_lag_days": 7,
    "ai_share_threshold": 0.25,  # disclosed-assistant share for a month to fire
    "ai_min_commits_month": 10,  # months smaller than this carry no share
    "join_none_threshold": 0.5,  # share of subjects naming nothing they touched
    "join_min_commits_month": 10,
}

# Tokens too common to count as naming anything. Declared rather than learned:
# a stop list fitted to a corpus is a judgement that has moved into data.
JOIN_STOP = set("the a an and or of to for in on at by with from into is are be "
                "was this that it its use uses using add adds added remove "
                "removes fix fixes fixed update updates updated make makes made "
                "new more some all not no only just also now then when where "
                "how what why work working".split())

# Matched against the NAME field of a co-author trailer only, never the address.
# The first hand-written version of this matched `ai` anywhere in the line and
# filed six human maintainers as assistants, because `gmail.com` contains it.
AI_TRAILER = re.compile(r"^\s*co-authored-by:\s*([^<\n]*)<", re.I | re.M)
AI_FAMILIES = [
    ("claude", re.compile(r"\bclaude\b", re.I)),
    ("chatgpt/gpt", re.compile(r"\b(chatgpt|gpt-?\d|openai)\b", re.I)),
    ("copilot", re.compile(r"\bcopilot\b", re.I)),
    ("gemini", re.compile(r"\bgemini\b", re.I)),
    ("other-agent", re.compile(r"\b(cursor|devin|aider|codex)\b", re.I)),
]

GOVERNANCE = re.compile(
    r"(^|/)(policy|charter|vision|roles|governance|contributing|code_of_conduct|"
    r"names|proposals|reporting-policy|license|licence)[^/]*\.(md|txt)$|"
    r"(^|/)(CONTRIBUTING|LICENSE|COPYING)([.-][^/]*)?$", re.I)

APPARATUS = [
    ("ci", re.compile(r"^\.github/workflows/.*\.ya?ml$")),
    ("tests", re.compile(r"^(tests?|regress|smtlibTests)/")),
    ("manifest", re.compile(
        r"^(pyproject\.toml|package\.json|Cargo\.toml|lakefile\.(lean|toml)|"
        r"CMakeLists\.txt|setup\.py|lean-toolchain)$")),
    ("style", re.compile(r"^(\.clang-format|\.editorconfig|ruff\.toml|"
                         r"\.flake8|setup\.cfg|\.pre-commit-config\.yaml)$")),
    ("ignore", re.compile(r"^\.gitignore$")),
    ("scripts", re.compile(r"^(scripts|bin|tools)/")),
]

VERSION_TAG = re.compile(r"^v?\d+(\.\d+)+")
ISO = re.compile(r"\b(\d{4}-\d{2}-\d{2})\b")

# Detectors that exist, and those the catalogue names and this does not
# implement. A run records both, so a missing detector is visible rather than
# silently absent.
IMPLEMENTED = ["ai-attribution", "message-join", "listed", "joined", "status-change", "delisted",
               "transplant", "birth", "death", "rewrite", "release",
               "governance", "apparatus", "quiet", "hands",
               "repo-added", "relation"]
NOT_IMPLEMENTED = {
    "dependency": "needs per-manifest parsing; the demo would only be able to "
                  "say that a manifest changed, which `governance` already says",
}
FAILURE_MODES = {
    "listed": "an inventory's first revision is a state and not a transition; "
              "everybody present at the start is reported at once, on a date "
              "that is the file's birthday rather than theirs",
    "joined": "reads the inventory, so it dates the *recording* of a join, not "
              "the join. Where the two differ the inventory is late and this "
              "cannot tell",
    "status-change": "sees a field change, never a reason. A footing corrected, "
                     "a vocabulary renamed and a decision reversed are one shape",
    "delisted": "removal and rename are indistinguishable without the key",
    "transplant": "a rewrite that keeps its structure scores as a move",
    "birth": "an import or fork gives everything one birthday; generated trees",
    "death": "a subsystem moving to another repository looks like a death",
    "rewrite": "formatting sweeps and regenerated files; size is approximated "
               "by cumulative added-minus-deleted, not measured at the commit",
    "release": "projects that do not tag are invisible to it",
    "governance": "the fact of the document is the event; it cannot see whether "
                  "anybody followed it",
    "apparatus": "apparatus inherited at creation is not an event, and this "
                 "cannot tell that from adoption",
    "quiet": "branch development and ordinary absence look identical",
    "hands": "one person with several addresses inflates the count",
    "message-join": "a subject can be excellent and join nothing -- *correct "
                    "the off-by-one boundary* names no path -- and can join "
                    "everything and say nothing, as *update docs* does over "
                    "`docs/`. It measures whether a subject can be tied to its "
                    "own diff mechanically, which is not the same as whether a "
                    "human could understand it, and a subject naming nothing is "
                    "not thereby a bad one",
    "ai-attribution": "it measures **disclosure and never contribution**. A "
                      "trailer is opt-in, so the floor is zero and there is no "
                      "ceiling: a tree with none is indistinguishable from a "
                      "tree where none was recorded, and those are not the same "
                      "fact. A human whose name contains a model family word "
                      "scores as an assistant",
    "repo-added": "the membership set is configuration, so this is only as good "
                  "as what somebody wrote down",
    "relation": "finds when a mention first appeared, not when a dependency "
                "became real",
}


def run(args, cwd=None):
    p = subprocess.run(args, cwd=cwd, capture_output=True, text=True)
    if p.returncode != 0:
        raise SystemExit(f"epikrisis: {' '.join(args[:3])}...: {p.stderr.strip()}")
    return p.stdout


def git(repo, *args):
    return run(["git", "-C", repo, *args])


def git_ok(repo, *args):
    """A git call that is allowed to fail -- a path that did not exist at a
    revision is an ordinary fact about a history, not an error."""
    p = subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True)
    return (p.returncode == 0, p.stdout)


def verify_pin(repo, src):
    """A recorded pin that nothing enforces is a manifest that lies.

    Every stage after `pin` reads the corpus at the commit the manifest names,
    never at whatever HEAD happens to be. This was not true of the first version
    and the trees moved underneath three runs before anybody noticed -- the
    numbers were re-derived from a different corpus than the one reported.
    """
    ok, _ = git_ok(repo, "cat-file", "-e", src["commit"] + "^{commit}")
    if not ok:
        raise SystemExit(
            f"epikrisis: {src['id']} does not contain its pinned commit "
            f"{src['commit'][:12]}. The evidence cannot be reproduced, so this "
            f"run fails rather than measuring something else. Re-`pin` if that "
            f"is what you meant.")


def anon(email):
    """Stage 1 sees an address; nothing downstream does. Only counts travel."""
    return hashlib.sha256(email.strip().lower().encode()).hexdigest()[:12]


def prefix_of(path, depth):
    """The directory a file sits in, truncated to `depth` components.

    It truncates the *directory*, not the path. Truncating the path made a file
    directly under a top-level directory its own prefix -- `tools/policy.md`
    read as a subsystem that was born and died. At depth 1 that was invisible,
    because the first component of any such path is the directory anyway; the
    defect only appeared the first time this ran at depth 2, which is the whole
    argument for running a tool at more than one setting before trusting it.
    """
    d = os.path.dirname(path)
    if not d:
        return "(root)"
    return "/".join(d.split("/")[:depth])


def subject_path(name):
    return os.path.join(HERE, "subjects", f"{name}.json")


def load_subject(name):
    p = subject_path(name)
    if not os.path.exists(p):
        raise SystemExit(f"epikrisis: no subject {name!r} in subjects/")
    s = json.load(open(p))
    t = dict(DEFAULT_THRESHOLDS)
    t.update(s.get("thresholds", {}))
    s["thresholds"] = t
    return s


def run_dir(name, when=None):
    d = os.path.join(HERE, "runs", name)
    if when:
        return os.path.join(d, when)
    if not os.path.isdir(d):
        raise SystemExit(f"epikrisis: no runs for {name}; `pin` first")
    stamps = sorted(x for x in os.listdir(d) if not x.startswith("."))
    if not stamps:
        raise SystemExit(f"epikrisis: no runs for {name}; `pin` first")
    return os.path.join(d, stamps[-1])


def load(rd, base):
    p = os.path.join(rd, base)
    if not os.path.exists(p):
        raise SystemExit(f"epikrisis: {base} missing; run the earlier stage")
    if base.endswith(".jsonl"):
        return [json.loads(l) for l in open(p) if l.strip()]
    return json.load(open(p))


def write(rd, base, obj):
    os.makedirs(rd, exist_ok=True)
    p = os.path.join(rd, base)
    with open(p, "w") as f:
        if base.endswith(".jsonl"):
            for r in obj:
                f.write(json.dumps(r, sort_keys=True) + "\n")
        else:
            json.dump(obj, f, indent=2, sort_keys=True)
            f.write("\n")
    print(f"  wrote {os.path.relpath(p, HERE)}")
    return p


# ---------------------------------------------------------------- stage 1

def cmd_pin(a):
    s = load_subject(a.subject)
    stamp = a.date or date.today().isoformat()
    rd = run_dir(a.subject, stamp)
    sources = []
    for src in s["sources"]:
        repo = os.path.join(a.frm, src.get("mirror", src["id"]))
        if not os.path.isdir(os.path.join(repo, ".git")):
            raise SystemExit(f"epikrisis: {repo} is not a git checkout")
        if git(repo, "rev-parse", "--is-shallow-repository").strip() == "true":
            raise SystemExit(f"epikrisis: {src['id']} is a shallow clone; "
                             "every detector would silently under-report")
        log = git(repo, "log", "--reverse", "--format=%ad", "--date=short").split()
        sources.append({
            "id": src["id"], "origin": src["origin"],
            "commit": git(repo, "rev-parse", "HEAD").strip(),
            "first_commit": log[0], "last_commit": log[-1], "commits": len(log),
        })
    qd = hashlib.sha256(open(os.path.join(HERE, "questions.md"), "rb").read()).hexdigest()
    corpus = {
        "subject": s["subject"], "kind": s["kind"], "self": s.get("self", False),
        "pinned": stamp, "tool_version": TOOL_VERSION,
        "date_field": "committer date, --date=short, as git reports it",
        "sources": sources, "exclude": s.get("exclude", []),
        "thresholds": s["thresholds"], "questions_digest": qd,
        "thresholds_changed_after_events": False,
        "detectors_implemented": IMPLEMENTED,
        "detectors_not_implemented": NOT_IMPLEMENTED,
        "not_in_corpus": s.get("not_in_corpus", []),
    }
    write(rd, "corpus.json", corpus)
    print(f"  {len(sources)} source(s), "
          f"{sum(x['commits'] for x in sources)} commits, "
          f"{min(x['first_commit'] for x in sources)} .. "
          f"{max(x['last_commit'] for x in sources)}")


# ---------------------------------------------------------------- stage 2

def read_log(repo, rev, exclude, depth):
    """One pass for churn, one for statuses. Returns per-commit records.

    Author addresses are read here and reduced to an opaque id immediately;
    nothing this function returns can name a person.
    """
    out = []
    sep = "\x01"
    raw = git(repo, "log", "--reverse", "--no-merges", "--date=short",
              f"--format={sep}%H%x02%ad%x02%ae%x02%s", "--numstat", rev)
    for block in raw.split(sep):
        if not block.strip():
            continue
        head, *rest = block.strip("\n").split("\n")
        sha, when, email, subject = head.split("\x02", 3)
        files = []
        for line in rest:
            if not line.strip():
                continue
            parts = line.split("\t")
            if len(parts) != 3:
                continue
            add, dele, path = parts
            if any(path.startswith(x) for x in exclude):
                continue
            files.append((0 if add == "-" else int(add),
                          0 if dele == "-" else int(dele), path))
        out.append({"sha": sha, "date": when, "who": anon(email),
                    "subject": subject, "files": files})
    return out


def read_status(repo, rev, exclude):
    """A/D/R statuses, with rename detection on. Renames are what make a
    reorganisation distinguishable from a subsystem dying."""
    out = []
    sep = "\x01"
    raw = git(repo, "log", "--reverse", "--no-merges", "--date=short",
              f"--format={sep}%H%x02%ad", "--name-status", "-M50%", rev)
    for block in raw.split(sep):
        if not block.strip():
            continue
        head, *rest = block.strip("\n").split("\n")
        sha, when = head.split("\x02")
        recs = []
        for line in rest:
            parts = line.split("\t")
            if len(parts) < 2:
                continue
            st = parts[0]
            paths = parts[1:]
            if any(any(p.startswith(x) for x in exclude) for p in paths):
                continue
            recs.append((st[0], paths))
        out.append({"sha": sha, "date": when, "recs": recs})
    return out


def detect(src_id, repo, rev, th, ecosystem_first=None):
    depth = th["prefix_depth"]
    exclude = th.get("_exclude", [])
    log = read_log(repo, rev, exclude, depth)
    status = read_status(repo, rev, exclude)
    alive = set()
    for p in git(repo, "ls-tree", "-r", "--name-only", rev).splitlines():
        if not any(p.startswith(x) for x in exclude):
            alive.add(prefix_of(p, depth))

    ev = []
    n = [0]

    def emit(det, when, sha, paths, measure, evidence=None, note=None):
        n[0] += 1
        ev.append({
            "id": f"{src_id}-{det}-{n[0]:04d}", "detector": det,
            "detector_version": 1, "source": src_id,
            "at": {"commit": sha, "date": when},
            "paths": paths, "measure": measure,
            "evidence": evidence or ([sha] if sha else []),
            "selected": None, "reason": None,
        })

    # ---- transplant, first: it suppresses the birth/death pair it explains
    moved = set()
    for c in status:
        groups = defaultdict(list)
        for st, paths in c["recs"]:
            if st == "R" and len(paths) == 2:
                groups[(prefix_of(paths[0], depth), prefix_of(paths[1], depth))].append(paths)
        for (a, b), ps in groups.items():
            if a != b and len(ps) >= th["transplant_min_files"]:
                emit("transplant", c["date"], c["sha"], [a, b],
                     {"files": len(ps)})
                moved.add((a, c["date"]))
                moved.add((b, c["date"]))

    # ---- per-prefix aggregates
    first_add, last_touch, touches = {}, {}, defaultdict(int)
    for c in status:
        for st, paths in c["recs"]:
            p = prefix_of(paths[-1], depth)
            touches[p] += 1
            last_touch[p] = (c["date"], c["sha"])
            if st == "A" and p not in first_add:
                first_add[p] = (c["date"], c["sha"])

    for p, (when, sha) in sorted(first_add.items()):
        if touches[p] >= th["min_commits_prefix"] and (p, when) not in moved:
            emit("birth", when, sha, [p], {"later_commits": touches[p]})
    for p, (when, sha) in sorted(last_touch.items()):
        if p not in alive and touches[p] >= th["min_commits_prefix"] \
                and (p, when) not in moved:
            emit("death", when, sha, [p], {"commits_before_death": touches[p]})

    # ---- rewrite: churn in a window against size at its start
    size = defaultdict(int)
    win = timedelta(days=th["rewrite_window_days"])
    by_prefix = defaultdict(list)
    for c in log:
        d = date.fromisoformat(c["date"])
        agg = defaultdict(lambda: [0, 0])
        for add, dele, path in c["files"]:
            p = prefix_of(path, depth)
            agg[p][0] += add
            agg[p][1] += dele
        for p, (add, dele) in agg.items():
            by_prefix[p].append((d, add, dele, c["sha"]))
    for p, items in by_prefix.items():
        if p not in alive:
            continue
        i = 0
        while i < len(items):
            start, cur = items[i][0], size[p]
            churn = 0
            j, last = i, items[i][3]
            while j < len(items) and items[j][0] - start <= win:
                churn += items[j][1] + items[j][2]
                size[p] += items[j][1] - items[j][2]
                last = items[j][3]
                j += 1
            if cur > 0 and churn >= th["rewrite_churn_ratio"] * cur:
                emit("rewrite", start.isoformat(), last, [p],
                     {"churn": churn, "size_at_start": cur,
                      "ratio": round(churn / cur, 2)})
            i = j

    # ---- release
    for tag in git(repo, "tag").split():
        if VERSION_TAG.match(tag):
            when = git(repo, "log", "-1", "--format=%ad", "--date=short", tag).strip()
            sha = git(repo, "rev-list", "-1", tag).strip()
            emit("release", when, sha, [], {"tag": tag})

    # ---- governance and apparatus
    seen_app = set()
    gov_added = set()
    for c in status:
        for st, paths in c["recs"]:
            path = paths[-1]
            if st == "A" and GOVERNANCE.search(path) and path not in gov_added:
                gov_added.add(path)
                emit("governance", c["date"], c["sha"], [path], {"kind": "added"})
            if st == "A":
                for kind, pat in APPARATUS:
                    if kind not in seen_app and pat.match(path):
                        seen_app.add(kind)
                        emit("apparatus", c["date"], c["sha"], [path],
                             {"kind": kind})
    for c in log:
        for add, dele, path in c["files"]:
            if GOVERNANCE.search(path) and add + dele >= th["governance_lines"] \
                    and path in gov_added:
                emit("governance", c["date"], c["sha"], [path],
                     {"kind": "revised", "lines": add + dele})

    # ---- quiet
    days = sorted({date.fromisoformat(c["date"]) for c in log})
    if len(days) > 2:
        gaps = [(days[i + 1] - days[i]).days for i in range(len(days) - 1)]
        med = max(statistics.median(gaps), 1)
        for i, g in enumerate(gaps):
            if g >= max(th["quiet_median_multiple"] * med, th["quiet_min_days"]):
                emit("quiet", days[i].isoformat(), None, [],
                     {"gap_days": g, "median_gap_days": med,
                      "resumed": days[i + 1].isoformat()})

    # ---- hands (counts only)
    wnd = th["hands_window_days"]
    if log:
        start = date.fromisoformat(log[0]["date"])
        end = date.fromisoformat(log[-1]["date"])
        prev = None
        d = start
        while d <= end:
            hi = d + timedelta(days=wnd)
            who = {c["who"] for c in log if d <= date.fromisoformat(c["date"]) < hi}
            if prev is not None and len(who) != prev and who:
                emit("hands", d.isoformat(), None, [],
                     {"distinct": len(who), "was": prev, "window_days": wnd})
            if who:
                prev = len(who)
            d = hi

    # ---- ai-attribution: disclosed assistant co-authorship, by month.
    # Reads the trailer and nothing else, which is the whole of what a history
    # can say about this. No human name is emitted: the measure carries counts
    # and model families, so nothing here can become a fact about a person.
    recs = git(repo, "log", "--no-merges", "--format=%H%x01%ad%x01%B%x02",
               "--date=short", rev).split("\x02")
    months, fams, first = defaultdict(lambda: [0, 0, None]), defaultdict(int), None
    for rec in recs:
        if not rec.strip():
            continue
        sha, when, body = rec.strip().split("\x01", 2)
        hit = {f for name in AI_TRAILER.findall(body)
               for f, rx in AI_FAMILIES if rx.search(name)}
        m = months[when[:7]]
        m[0] += 1
        m[2] = sha
        if hit:
            m[1] += 1
            for f in hit:
                fams[f] += 1
            if first is None or when < first[1]:
                first = (sha, when)
    if first:
        emit("ai-attribution", first[1], first[0], ["(trailers)"],
             {"kind": "first-disclosure", "families": dict(sorted(fams.items()))})
    over = False
    for month in sorted(months):
        total, att, sha = months[month]
        if total < th["ai_min_commits_month"]:
            continue
        now = att / total >= th["ai_share_threshold"]
        if now != over:
            emit("ai-attribution", month + "-01", sha, ["(trailers)"],
                 {"kind": "share-crossed", "month": month, "commits": total,
                  "attributed": att, "share": round(att / total, 3),
                  "direction": "up" if now else "down"})
            over = now

    # ---- message-join: does a subject name anything its own commit touched?
    # Not a quality score, and deliberately not called one: it is a mechanical
    # join between the subject's tokens and the changed paths' own vocabulary.
    # Nothing is summarised, no model is asked what a commit did, and the
    # message is the object of the measurement rather than evidence for an event.
    jm = defaultdict(lambda: [0, 0, None])
    for c in log:
        subj = c.get("subject", "")
        vocab = set()
        for _, _, path in c["files"]:
            for seg in re.split(r"[/._-]", path.lower()):
                if len(seg) >= 3:
                    vocab.add(seg)
        st = {w for w in re.findall(r"[a-z0-9]+", subj.lower())
              if len(w) >= 3 and w not in JOIN_STOP}
        joins = bool(st & vocab) or any(t in v or v in t
                                        for t in st for v in vocab if len(v) >= 4)
        m = jm[c["date"][:7]]
        m[0] += 1
        m[2] = c["sha"]
        if not joins:
            m[1] += 1
    none_over = False
    for month in sorted(jm):
        total, none_n, sha = jm[month]
        if total < th["join_min_commits_month"]:
            continue
        now = none_n / total >= th["join_none_threshold"]
        if now != none_over:
            emit("message-join", month + "-01", sha, ["(subjects)"],
                 {"kind": "share-crossed", "month": month, "commits": total,
                  "named_nothing": none_n, "share": round(none_n / total, 3),
                  "direction": "up" if now else "down"})
            none_over = now

    # ---- repo-added (ecosystem mode)
    if ecosystem_first is not None and log:
        emit("repo-added", log[0]["date"], log[0]["sha"], [],
             {"source": src_id, "days_after_first_source":
              (date.fromisoformat(log[0]["date"]) - ecosystem_first).days})
    return ev


def detect_inventory(corpus, frm, inv):
    """Status transitions, read out of an inventory file's own history.

    For an ecosystem, this is the primary event class and everything else in the
    catalogue is secondary: a tool joining, or changing what it is to the
    others, is an event in a way that a directory appearing inside one of its
    members is not. It is derivable here only because somebody already keeps the
    inventory as a file -- a footing recorded in prose has no history a diff can
    read, which is the whole of the argument in the topic this detector came
    from.
    """
    repo = os.path.join(frm, inv["source"])
    path = inv["path"]
    track = inv.get("track", ["status"])
    src = next((x for x in corpus["sources"] if x["id"] == inv["source"]), None)
    verify_pin(repo, src) if src else None
    revs = git(repo, "log", "--reverse", "--format=%H %ad", "--date=short",
               (src["commit"] if src else "HEAD"), "--", path).splitlines()
    first_commit = {s["id"]: s["first_commit"] for s in corpus["sources"]}
    ev, k, unreadable = [], 0, 0
    prev = None
    for line in revs:
        sha, when = line.split()
        ok, blob = git_ok(repo, "show", f"{sha}:{path}")
        if not ok:
            unreadable += 1
            continue
        try:
            data = json.loads(blob)
        except json.JSONDecodeError:
            unreadable += 1
            continue
        cur = {n: {f: e.get(f) for f in track}
               for n, e in data.items()
               if n != "_comment" and isinstance(e, dict)}
        def emit(det, name, measure):
            nonlocal k
            k += 1
            ev.append({
                "id": f"eco-{det}-{k:04d}", "detector": det,
                "detector_version": 1, "source": inv["source"],
                "at": {"commit": sha, "date": when}, "paths": [path],
                "measure": dict(measure, tool=name), "evidence": [sha],
                "selected": None, "reason": None})

        # The first revision is a *state*, not a transition. Reporting nothing
        # for it loses everybody who was there when the inventory started --
        # which for a young ecosystem is most of it.
        if prev is None:
            for name in sorted(cur):
                emit("listed", name, {"as": cur[name].get("status"),
                                      "at_inventory_start": True})
            prev = cur
            continue

        for name in cur:
            if name not in prev:
                emit("listed", name, {"as": cur[name].get("status")})
                if cur[name].get("status") == "member" and name in first_commit:
                    emit("joined", name, {
                        "to": "member", "from": None,
                        "days_after_first_commit":
                            (date.fromisoformat(when)
                             - date.fromisoformat(first_commit[name])).days})
                continue
            for f in track:
                a, b = prev[name].get(f), cur[name].get(f)
                if a == b:
                    continue
                if f == "status" and b == "member":
                    emit("joined", name, {
                        "from": a, "to": b,
                        "days_after_first_commit":
                            (date.fromisoformat(when)
                             - date.fromisoformat(first_commit[name])).days
                            if name in first_commit else None})
                else:
                    emit("status-change", name, {"field": f, "from": a, "to": b})
        for name in prev:
            if name not in cur:
                emit("delisted", name, {"was": prev[name].get("status")})
        prev = cur
    return ev, {"revisions": len(revs), "unreadable": unreadable}


def detect_relations(corpus, frm, th):
    ev, k = [], 0
    ids = [s["id"] for s in corpus["sources"]]
    for s in corpus["sources"]:
        repo = os.path.join(frm, s["id"])
        for other in ids:
            if other == s["id"]:
                continue
            found = git(repo, "log", "--reverse", "--format=%H %ad",
                        "--date=short", "-S", other, s["commit"],
                        "--", ".").splitlines()
            if found:
                sha, when = found[0].split()
                k += 1
                ev.append({
                    "id": f"eco-relation-{k:04d}", "detector": "relation",
                    "detector_version": 1, "source": s["id"],
                    "at": {"commit": sha, "date": when}, "paths": [],
                    "measure": {"from": s["id"], "to": other,
                                "kind": "first mention in tracked files"},
                    "evidence": [sha], "selected": None, "reason": None})
    return ev


def cmd_events(a):
    # `--run` is offered on every stage; honouring it in only some of them
    # let a pin land in one directory and its events in another, silently,
    # whenever a stamp did not sort last. Found 2026-09-02 by running it.
    rd = run_dir(a.subject, a.run) if getattr(a, "run", None) else run_dir(a.subject)
    corpus = load(rd, "corpus.json")
    th = dict(corpus["thresholds"])
    th["_exclude"] = corpus.get("exclude", [])
    first = min(date.fromisoformat(s["first_commit"]) for s in corpus["sources"])
    ev = []
    for s in corpus["sources"]:
        repo = os.path.join(a.frm, s["id"])
        verify_pin(repo, s)
        ev += detect(s["id"], repo, s["commit"], th,
                     ecosystem_first=first if corpus["kind"] == "ecosystem" else None)
    inv_stats = None
    if corpus["kind"] == "ecosystem":
        ev += detect_relations(corpus, a.frm, th)
        s = load_subject(a.subject)
        if s.get("inventory"):
            iev, inv_stats = detect_inventory(corpus, a.frm, s["inventory"])
            ev += iev
    ev.sort(key=lambda e: (e["at"]["date"], e["id"]))
    write(rd, "events.jsonl", ev)
    by = defaultdict(int)
    for e in ev:
        by[e["detector"]] += 1
    print("  candidates: " + ", ".join(f"{k} {v}" for k, v in sorted(by.items())))
    print(f"  {len(ev)} total. None is selected; selection is stage 5.")
    if inv_stats:
        print(f"  inventory: {inv_stats['revisions']} revisions read, "
              f"{inv_stats['unreadable']} unreadable")
    named = {e["measure"].get("tool") for e in ev
             if e["detector"] in ("listed", "joined", "status-change", "delisted")}
    declared = {s["id"] for s in corpus["sources"]}
    if named:
        drift = sorted(named - declared - {None})
        if drift:
            print(f"  note: the inventory names {len(drift)} tool(s) this "
                  f"subject does not read: {', '.join(drift)}")


# ---------------------------------------------------------------- stage 3

def cmd_record(a):
    rd = run_dir(a.subject, a.run) if getattr(a, "run", None) else run_dir(a.subject)
    corpus = load(rd, "corpus.json")
    claims, k = [], 0

    def add(src, path, line, kind, when, text):
        nonlocal k
        k += 1
        claims.append({"id": f"C{k:04d}", "source": src,
                       "at": {"path": path, "line": line},
                       "kind": kind, "asserted": when,
                       "text": text.strip()[:300]})

    for s in corpus["sources"]:
        repo = os.path.join(a.frm, s["id"])
        verify_pin(repo, s)
        files = git(repo, "ls-tree", "-r", "--name-only", s["commit"]).splitlines()
        for path in files:
            if not path.endswith(".md"):
                continue
            base = os.path.basename(path)
            ok, text = git_ok(repo, "show", f"{s['commit']}:{path}")
            if not ok:
                continue
            lines = text.splitlines()
            for i, ln in enumerate(lines):
                nxt = "\n".join(lines[i:i + 8])
                m = re.match(r"^##\s+(D\d+)\s+—\s+(.+)$", ln)
                if m and base == "discussion.md":
                    d = re.search(r"\*\*Opened:\*\*\s*(\d{4}-\d{2}-\d{2})", nxt)
                    add(s["id"], path, i + 1, "dated-topic",
                        d.group(1) if d else None, ln)
                    continue
                if base == "names.md" and re.search(r"\*\*(Started|Approved)\*\*", ln):
                    add(s["id"], path, i + 1, "register-entry", None, ln)
                    continue
                if re.match(r"^\*\*Decided:\*\*", ln):
                    d = ISO.search(nxt)
                    add(s["id"], path, i + 1, "decision",
                        d.group(1) if d else None, ln)
                    continue
                if base in ("TODO.md", "ROADMAP.md") and re.match(r"^\s*-\s*\[x\]", ln):
                    add(s["id"], path, i + 1, "checkbox", None, ln)
                    continue
                if re.search(r"folded into|retired in place|retired unstarted|"
                             r"has since been \*\*folded", ln, re.I):
                    d = ISO.search(nxt)
                    add(s["id"], path, i + 1, "retirement",
                        d.group(1) if d else None, ln)
    write(rd, "claims.jsonl", claims)
    by = defaultdict(int)
    for c in claims:
        by[c["kind"]] += 1
    print("  claims: " + ", ".join(f"{k} {v}" for k, v in sorted(by.items())))
    dated = sum(1 for c in claims if c["asserted"])
    print(f"  {len(claims)} total, {dated} carry a date "
          f"({len(claims) - dated} cannot be placed on a timeline)")


# ---------------------------------------------------------------- stage 4

def cmd_delta(a):
    rd = run_dir(a.subject, a.run) if getattr(a, "run", None) else run_dir(a.subject)
    corpus = load(rd, "corpus.json")
    events = load(rd, "events.jsonl")
    claims = load(rd, "claims.jsonl")
    lag = corpus["thresholds"]["delta_lag_days"]

    # A date window only discriminates if it is small against the subject's own
    # span. On a subject whose whole history is days long it matches everything
    # to everything, which the first run of this pipeline duly did -- 982 pairs
    # out of 105 claims. So: proximity alone is not a match unless the window is
    # narrow relative to the span, and a shared path is required otherwise.
    per_source_span = {}
    for s in corpus["sources"]:
        per_source_span[s["id"]] = max(
            (date.fromisoformat(s["last_commit"])
             - date.fromisoformat(s["first_commit"])).days, 1)
    weak_ok = {sid: lag * 4 <= span for sid, span in per_source_span.items()}

    matched, disagreeing, used_e, used_c = [], [], set(), set()
    for c in claims:
        if not c["asserted"]:
            continue
        cd = date.fromisoformat(c["asserted"])
        for e in events:
            if e["source"] != c["source"]:
                continue
            gap = abs((date.fromisoformat(e["at"]["date"]) - cd).days)
            shares_path = any(p and p != "(root)" and p in c["text"]
                              for p in e["paths"])
            if not shares_path and not weak_ok.get(e["source"], False):
                continue
            if gap <= lag:
                matched.append({"event": e["id"], "claim": c["id"],
                                "lag_days": gap,
                                "strength": "strong" if shares_path else "weak"})
                used_e.add(e["id"])
                used_c.add(c["id"])
            elif shares_path:
                disagreeing.append({"event": e["id"], "claim": c["id"],
                                    "lag_days": gap})
                used_e.add(e["id"])
                used_c.add(c["id"])
    delta = {
        "matched": matched, "disagreeing": disagreeing,
        "declared_only": [c["id"] for c in claims if c["id"] not in used_c],
        "derived_only": [e["id"] for e in events if e["id"] not in used_e],
        "note": ("undated claims cannot be matched and fall to declared_only; "
                 "see the matcher's limits in the report"),
        "weak_matching": {sid: ("enabled" if ok else
                                "disabled: the lag window is not small against "
                                "this source's span")
                          for sid, ok in weak_ok.items()},
    }
    write(rd, "delta.json", delta)
    print(f"  matched {len(matched)}, disagreeing {len(disagreeing)}, "
          f"declared-only {len(delta['declared_only'])}, "
          f"derived-only {len(delta['derived_only'])}")


# ---------------------------------------------------------------- stage 5/6

def cmd_prompt(a):
    rd = run_dir(a.subject, a.run) if getattr(a, "run", None) else run_dir(a.subject)
    corpus = load(rd, "corpus.json")
    events = load(rd, "events.jsonl")
    claims = load(rd, "claims.jsonl")
    delta = load(rd, "delta.json")
    q = open(os.path.join(HERE, "questions.md")).read()
    print("=" * 72)
    print("EVIDENCE. Write the report from this and nothing else.")
    print("Every claim-bearing sentence cites an event or claim id.")
    print("=" * 72)
    print(json.dumps(corpus, indent=2, sort_keys=True))
    print("--- events ---")
    for e in events:
        print(json.dumps(e, sort_keys=True))
    print("--- claims ---")
    for c in claims:
        print(json.dumps(c, sort_keys=True))
    print("--- delta ---")
    print(json.dumps(delta, indent=2, sort_keys=True))
    print("--- questions ---")
    print(q)


def check_problems(rd):
    """Every condition stage 6 enforces, as a list of problems.

    Split out of `cmd_check` so that `selftest` can call it against a run it has
    deliberately broken. A check nobody has ever seen fail is the failure mode
    this ecosystem keeps rediscovering, and the answer is a canary.
    """
    corpus = load(rd, "corpus.json")
    events = {e["id"]: e for e in load(rd, "events.jsonl")}
    claims = {c["id"] for c in load(rd, "claims.jsonl")}
    rp = os.path.join(rd, "report.md")
    ap = os.path.join(rd, "assessments.jsonl")
    if not os.path.exists(rp) or not os.path.exists(ap):
        raise SystemExit("epikrisis: no report.md/assessments.jsonl in " + rd)
    report = open(rp).read()
    assessments = [json.loads(l) for l in open(ap) if l.strip()]
    sel = {}
    sp = os.path.join(rd, "selection.jsonl")
    if os.path.exists(sp):
        sel = {r["event"]: r for r in (json.loads(l) for l in open(sp) if l.strip())}

    bad = []
    cited = set(re.findall(r"\b([a-z0-9-]+-\d{4}|C\d{4})\b", report))
    for i in cited:
        if i not in events and i not in claims:
            bad.append(f"report cites {i}, which is in no evidence file")
    for A in assessments:
        if not A.get("rests_on"):
            bad.append(f"{A['id']} rests on nothing")
        for i in A.get("rests_on", []):
            if i not in events and i not in claims:
                bad.append(f"{A['id']} rests on {i}, which does not exist")
        if not A.get("falsified_by", "").strip():
            bad.append(f"{A['id']} has no falsifier")
        if A.get("direction") not in ("well", "badly"):
            bad.append(f"{A['id']} has no direction")
    if not any(A.get("direction") == "badly" for A in assessments):
        bad.append("no assessment in the `badly` direction: a run with nothing "
                   "negative is a failed run, not a clean subject")
    if corpus.get("self") and not any(A.get("direction") == "badly"
                                      for A in assessments):
        bad.append("self-assessment with no negative findings is void")
    unaccounted = [i for i in events
                   if i not in cited
                   and not any(i in A.get("rests_on", []) for A in assessments)
                   and i not in sel]
    if unaccounted:
        bad.append(f"{len(unaccounted)} candidate events are neither cited nor "
                   f"dropped with a reason (first: {sorted(unaccounted)[:3]})")
    for flag, why in (("thresholds_changed_after_events", "fitted thresholds"),
                      ("self", "self-assessment")):
        if corpus.get(flag) and why not in report.lower() \
                and flag.replace("_", " ") not in report.lower():
            bad.append(f"manifest flag {flag!r} is not reproduced in the report "
                       f"header")
    return bad, {"assessments": len(assessments), "cited": len(cited),
                 "events": len(events)}


def cmd_check(a):
    # Runs are selected by newest stamp, so a later evidence-only run would
    # otherwise silently become the thing `check` reports on.
    rd = run_dir(a.subject, a.run) if getattr(a, "run", None) else run_dir(a.subject)
    bad, n = check_problems(rd)
    if bad:
        print("check: FAIL")
        for b in bad:
            print("  - " + b)
        return 1
    print(f"check: ok — {n['assessments']} assessments, {n['cited']} ids cited, "
          f"{n['events']} candidates all accounted for")
    return 0


# Deliberately crude, and declared rather than inferred. A cleverer classifier
# would be a judgement wearing a program's face; this one is wrong in ways a
# reader can predict from the list itself.
PROSE_EXT = {".md", ".txt", ".rst", ".org"}
TOOL_EXT = {".py", ".sh", ".lean", ".cpp", ".cc", ".h", ".hpp", ".c", ".rs",
            ".eo", ".eos", ".yml", ".yaml", ".toml", ".cmake", ".mk", ".bzl",
            ".smt2", ".proof", ".expected"}
TOOL_NAMES = {"CMakeLists.txt", "Makefile", "lakefile.lean", "lakefile.toml",
              "lean-toolchain", "Dockerfile"}


def bucket(path):
    base = os.path.basename(path)
    if base in TOOL_NAMES:
        return "tool"
    ext = os.path.splitext(path)[1].lower()
    if ext in PROSE_EXT:
        return "prose"
    if ext in TOOL_EXT:
        return "tool"
    # An extensionless file under bin/ or scripts/ is an executable. The first
    # run of this measure classified a 700-line program as `other` because it
    # had no suffix -- in the very repository whose ratio was being measured.
    if not ext and (path.startswith("bin/") or path.startswith("scripts/")
                    or "/bin/" in path or "/scripts/" in path):
        return "tool"
    return "other"


def cmd_ratio(a):
    """Lines of tool against lines about tools, per repository, per month.

    This measure exists because somebody else's register names it as the
    falsifier of its own central worry and says nobody measures it. It is
    reported per repository and never as one number: for a repository whose
    product *is* a document, prose is the tool, and an aggregate would hide
    exactly the case that matters.
    """
    rd = run_dir(a.subject, a.run) if getattr(a, "run", None) else run_dir(a.subject)
    corpus = load(rd, "corpus.json")
    sub = load_subject(a.subject)
    prose_product = set(sub.get("prose_is_product", []))
    exclude = corpus.get("exclude", [])
    out = {"_note": cmd_ratio.__doc__.strip().splitlines()[0],
           "classifier": {"prose": sorted(PROSE_EXT), "tool": sorted(TOOL_EXT),
                          "tool_names": sorted(TOOL_NAMES),
                          "everything else": "other, reported and not counted "
                                             "into either side"},
           "prose_is_product": sorted(prose_product), "sources": {}}
    for s in corpus["sources"]:
        repo = os.path.join(a.frm, s["id"])
        months = defaultdict(lambda: defaultdict(int))
        verify_pin(repo, s)
        raw = git(repo, "log", "--reverse", "--no-merges", "--date=short",
                  "--format=\x01%ad", "--numstat", s["commit"])
        for block in raw.split("\x01"):
            if not block.strip():
                continue
            head, *rest = block.strip("\n").split("\n")
            month = head[:7]
            for line in rest:
                p = line.split("\t")
                if len(p) != 3 or p[0] == "-":
                    continue
                add, _, path = p
                if any(path.startswith(x) for x in exclude):
                    continue
                months[month][bucket(path)] += int(add)
        tot = defaultdict(int)
        rows = {}
        for m in sorted(months):
            b = months[m]
            for k, v in b.items():
                tot[k] += v
            rows[m] = {"prose": b["prose"], "tool": b["tool"],
                       "other": b["other"],
                       "prose_per_tool": (round(b["prose"] / b["tool"], 2)
                                          if b["tool"] else None)}
        out["sources"][s["id"]] = {
            "months": rows,
            "total": {"prose": tot["prose"], "tool": tot["tool"],
                      "other": tot["other"],
                      "prose_per_tool": (round(tot["prose"] / tot["tool"], 2)
                                         if tot["tool"] else None)},
            "prose_is_product": s["id"] in prose_product,
        }
    write(rd, "ratio.json", out)
    print(f"  {'source':12} {'month':8} {'prose':>8} {'tool':>8} {'other':>7} {'prose/tool':>11}")
    for sid, d in out["sources"].items():
        for m, r in d["months"].items():
            pt = "-" if r["prose_per_tool"] is None else f"{r['prose_per_tool']:.2f}"
            print(f"  {sid:12} {m:8} {r['prose']:8} {r['tool']:8} {r['other']:7} {pt:>11}")
        t = d["total"]
        pt = "-" if t["prose_per_tool"] is None else f"{t['prose_per_tool']:.2f}"
        flag = "  [prose is this tree's product]" if d["prose_is_product"] else ""
        print(f"  {sid:12} {'TOTAL':8} {t['prose']:8} {t['tool']:8} {t['other']:7} {pt:>11}{flag}")
    return 0


CANARY = {
    "corpus.json": {
        "subject": "canary", "kind": "tool", "self": True, "pinned": "2026-01-01",
        "tool_version": "canary", "sources": [], "exclude": [], "thresholds": {},
        "questions_digest": "canary", "thresholds_changed_after_events": False,
    },
    "events.jsonl": [
        {"id": "x-birth-0001", "detector": "birth", "source": "x",
         "at": {"commit": "a", "date": "2026-01-01"}, "paths": ["p"],
         "measure": {}, "evidence": ["a"], "selected": None, "reason": None},
        {"id": "x-birth-0002", "detector": "birth", "source": "x",
         "at": {"commit": "b", "date": "2026-01-02"}, "paths": ["q"],
         "measure": {}, "evidence": ["b"], "selected": None, "reason": None},
    ],
    "claims.jsonl": [
        {"id": "C0001", "source": "x", "at": {"path": "R.md", "line": 1},
         "kind": "checkbox", "asserted": None, "text": "t"},
    ],
    "assessments.jsonl": [
        {"id": "A1", "direction": "well", "claim": "c", "rests_on": ["x-birth-0001"],
         "falsified_by": "a later run showing otherwise at p", "confidence": "low",
         "scope": "s"},
        {"id": "A2", "direction": "badly", "claim": "c", "rests_on": ["C0001"],
         "falsified_by": "the claim at R.md:1 reading differently", "confidence": "low",
         "scope": "s"},
    ],
    "selection.jsonl": [
        {"event": "x-birth-0002", "kept": False, "reason": "noise", "by": "canary",
         "run": "canary"},
    ],
    "report.md": ("# canary\n\nThis is a self-assessment.\n\n"
                  "Something happened (x-birth-0001), and the record says so (C0001).\n"),
}

# Each mutation must make `check` fail. A mutation that stops failing means the
# condition it targets has been weakened or removed.
MUTATIONS = [
    ("cites an id that is in no evidence file",
     lambda d: d.__setitem__("report.md", d["report.md"] + "\nAlso x-birth-9999.\n")),
    ("an assessment resting on an id that does not exist",
     lambda d: d["assessments.jsonl"][0].__setitem__("rests_on", ["x-birth-9999"])),
    ("an assessment with an empty falsifier",
     lambda d: d["assessments.jsonl"][0].__setitem__("falsified_by", "  ")),
    ("no assessment in the `badly` direction",
     lambda d: d.__setitem__("assessments.jsonl", d["assessments.jsonl"][:1])),
    ("a candidate event neither cited nor dropped with a reason",
     lambda d: d.__setitem__("selection.jsonl", [])),
    ("a manifest flag missing from the report header",
     lambda d: d.__setitem__("report.md", d["report.md"].replace("self-assessment", "run"))),
]


def cmd_panel(a):
    """Per-prefix dial readings as of the pin: activity, gap, disclosed share.

    It reports positions and never a verdict. Whether a gap is too long or a
    rate too fast needs a line drawn by somebody with the standing to draw it;
    this says where each prefix sits, with the provenance to re-derive it, and
    stops. Retirement is deliberately absent: a prefix with no recent commit is
    a fact about a tree, and a tool being *dead* is a decision recorded by
    whoever holds the ecosystem's governance, not read out of a log.
    """
    rd = run_dir(a.subject, a.run) if getattr(a, "run", None) else run_dir(a.subject)
    corpus = load(rd, "corpus.json")
    th = corpus["thresholds"]
    depth, exclude = th["prefix_depth"], corpus.get("exclude", [])
    pinned = date.fromisoformat(corpus["pinned"])
    out = {"produced_by": "epikrisis " + TOOL_VERSION,
           "provenance": {"subject": corpus["subject"], "pinned": corpus["pinned"],
                          "sources": [{"id": x["id"], "commit": x["commit"]}
                                      for x in corpus["sources"]],
                          "prefix_depth": depth, "excluded": exclude,
                          "questions_digest": corpus.get("questions_digest"),
                          "self_assessment": bool(corpus.get("self")),
                          "re_derive": "epikrisis pin && epikrisis panel, from "
                                       "the same checkouts at these commits"},
           "reports": "position, never a grade. No band, no score, no ranking",
           "not_here": {"retirement": "a prefix with no recent commit is a fact; "
                                      "a tool being dead is a governance "
                                      "decision and is not this tool's to make",
                        "ai_generation": "not derivable. `disclosed_share` is a "
                                         "floor with no ceiling: a prefix at 0 "
                                         "may be wholly assistant-written and "
                                         "simply not record it"},
           "prefixes": []}
    for src in corpus["sources"]:
        repo = os.path.join(a.frm, src["id"])
        verify_pin(repo, src)
        log = read_log(repo, src["commit"], exclude, depth)
        attributed = set()
        for rec in git(repo, "log", "--no-merges", "--format=%H%x01%B%x02",
                       src["commit"]).split("\x02"):
            if not rec.strip():
                continue
            sha, body = rec.strip().split("\x01", 1)
            if any(rx.search(n) for n in AI_TRAILER.findall(body)
                   for _, rx in AI_FAMILIES):
                attributed.add(sha)
        when, counts = defaultdict(list), defaultdict(lambda: [0, 0])
        for c in log:
            for pre in {prefix_of(f[2], depth) for f in c["files"]}:
                when[pre].append(c["date"])
                counts[pre][0] += 1
                if c["sha"] in attributed:
                    counts[pre][1] += 1
        for pre in sorted(when):
            ds = sorted(date.fromisoformat(d) for d in when[pre])
            if len(ds) < th["min_commits_prefix"]:
                continue
            gaps = sorted((ds[i + 1] - ds[i]).days for i in range(len(ds) - 1))
            med = gaps[len(gaps) // 2] if gaps else 0
            since = (pinned - ds[-1]).days
            n, att = counts[pre]
            out["prefixes"].append(
                {"source": src["id"], "prefix": pre, "commits": n,
                 "first": ds[0].isoformat(), "last": ds[-1].isoformat(),
                 "days_since_last": since, "median_gap_days": med,
                 "gap_over_median": round(since / med, 1) if med else None,
                 "disclosed_ai": att,
                 "disclosed_share": round(att / n, 3) if n else 0.0})
    write(rd, "panel.json", out)
    print(f"  {'source':12} {'prefix':22} {'cmts':>5} {'last':>5} {'med':>4} "
          f"{'x':>5} {'ai%':>6}")
    for r in out["prefixes"]:
        x = "-" if r["gap_over_median"] is None else f"{r['gap_over_median']:.1f}"
        print(f"  {r['source']:12} {r['prefix'][:22]:22} {r['commits']:5d} "
              f"{r['days_since_last']:5d} {r['median_gap_days']:4d} {x:>5} "
              f"{100 * r['disclosed_share']:5.1f}%")
    print("  last = days since last commit; med = median gap; x = last/med.")
    print("  No row here is a verdict. Retirement is not reported: see not_here.")
    return 0


def cmd_selftest(a):
    """Prove that `check` can fail, one condition at a time.

    Nothing else in this repository is entitled to say *a check that cannot fail
    is not a check* while its own check has only ever passed.
    """
    import copy
    import shutil
    import tempfile

    def lay(d, into):
        os.makedirs(into, exist_ok=True)
        for name, body in d.items():
            with open(os.path.join(into, name), "w") as f:
                if name.endswith(".jsonl"):
                    for r in body:
                        f.write(json.dumps(r, sort_keys=True) + "\n")
                elif name.endswith(".json"):
                    json.dump(body, f)
                else:
                    f.write(body)

    tmp = tempfile.mkdtemp(prefix="epikrisis-selftest-")
    failures = []
    try:
        clean = os.path.join(tmp, "clean")
        lay(copy.deepcopy(CANARY), clean)
        bad, _ = check_problems(clean)
        if bad:
            failures.append(f"the clean canary does not pass: {bad}")
            print("  FAIL  clean canary rejected")
        else:
            print("  ok    clean canary passes")

        for i, (name, mutate) in enumerate(MUTATIONS):
            d = copy.deepcopy(CANARY)
            mutate(d)
            here = os.path.join(tmp, f"m{i}")
            lay(d, here)
            bad, _ = check_problems(here)
            if bad:
                print(f"  ok    caught: {name}")
            else:
                failures.append(f"NOT caught: {name}")
                print(f"  FAIL  NOT caught: {name}")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

    tiny = dict(BUDGET, tool_lines=1, doc_lines_over_tool=0.0,
                subprocess_sites=0)
    if budget_problems(budget_facts(), tiny):
        print("  ok    caught: an implementation over budget")
    else:
        failures.append("NOT caught: an implementation over budget")
        print("  FAIL  NOT caught: an implementation over budget")

    if failures:
        print(f"selftest: FAIL — {len(failures)} condition(s) do not fire")
        return 1
    print(f"selftest: ok — the clean canary passes and all "
          f"{len(MUTATIONS)} conditions fire")
    return 0


# Ambitious in functionality, unambitious in implementation. The questions this
# tool asks are as large as they need to be; the machinery that answers them is
# held small on purpose, because the way an analysis tool goes wrong is by
# absorbing judgement into code where nobody can see it. Each limit is a number
# somebody chose, and raising one is a person's decision, recorded.
BUDGET = {
    "tool_lines": 1500,          # a reader must be able to check it in an hour
    "doc_lines_over_tool": 1.0,  # prose about the tool may not outgrow the tool
    "third_party_imports": 0,    # stdlib only: no install, no version skew
    "network_imports": 0,        # the corpus is on disk; nothing here fetches
    "subprocess_sites": 2,       # exactly the two git wrappers, and nothing else
}
NETWORK = {"urllib", "http", "socket", "ssl", "ftplib", "smtplib", "asyncio",
           "requests", "httpx", "aiohttp", "telnetlib", "xmlrpc"}


def budget_facts():
    src = open(os.path.join(HERE, "bin", "epikrisis")).read()
    tree = ast.parse(src)
    mods = set()
    for n in ast.walk(tree):
        if isinstance(n, ast.Import):
            mods |= {a.name.split(".")[0] for a in n.names}
        elif isinstance(n, ast.ImportFrom) and n.module and not n.level:
            mods.add(n.module.split(".")[0])
    sites = sum(1 for n in ast.walk(tree)
                if isinstance(n, ast.Call)
                and isinstance(n.func, ast.Attribute)
                and n.func.attr == "run"
                and isinstance(n.func.value, ast.Name)
                and n.func.value.id == "subprocess")
    docs = 0
    for d in (os.path.join(HERE, "docs"), HERE):
        for f in sorted(os.listdir(d)):
            if f.endswith(".md") and os.path.isfile(os.path.join(d, f)):
                docs += sum(1 for _ in open(os.path.join(d, f)))
    stdlib = getattr(sys, "stdlib_module_names", set())
    return {
        "tool_lines": src.count("\n"),
        "doc_lines": docs,
        "third_party_imports": sorted(m for m in mods
                                      if stdlib and m not in stdlib),
        "network_imports": sorted(mods & NETWORK),
        "subprocess_sites": sites,
    }


def budget_problems(f, limits):
    bad = []
    if f["tool_lines"] > limits["tool_lines"]:
        bad.append(f"the tool is {f['tool_lines']} lines, over {limits['tool_lines']}")
    if f["tool_lines"] and f["doc_lines"] > limits["doc_lines_over_tool"] * f["tool_lines"]:
        bad.append(f"{f['doc_lines']} lines of prose against {f['tool_lines']} of "
                   f"tool: the account has outgrown the thing it accounts for")
    if len(f["third_party_imports"]) > limits["third_party_imports"]:
        bad.append(f"imports outside the stdlib: {f['third_party_imports']}")
    if len(f["network_imports"]) > limits["network_imports"]:
        bad.append(f"network imports: {f['network_imports']}")
    if f["subprocess_sites"] > limits["subprocess_sites"]:
        bad.append(f"{f['subprocess_sites']} subprocess call sites, over "
                   f"{limits['subprocess_sites']}: the derivation path may run "
                   f"git and nothing else")
    return bad


def cmd_budget(a):
    """What the implementation is allowed to become, counted.

    A budget with no counter is a preference. This is the counter.
    """
    f = budget_facts()
    print(f"  tool                 {f['tool_lines']:>6} lines   "
          f"(limit {BUDGET['tool_lines']})")
    print(f"  prose about it       {f['doc_lines']:>6} lines   "
          f"(limit {BUDGET['doc_lines_over_tool']:g}x the tool = "
          f"{int(BUDGET['doc_lines_over_tool'] * f['tool_lines'])})")
    print(f"  third-party imports  {len(f['third_party_imports']):>6}         "
          f"(limit {BUDGET['third_party_imports']})")
    print(f"  network imports      {len(f['network_imports']):>6}         "
          f"(limit {BUDGET['network_imports']})")
    print(f"  subprocess sites     {f['subprocess_sites']:>6}         "
          f"(limit {BUDGET['subprocess_sites']}, both git wrappers)")
    bad = budget_problems(f, BUDGET)
    if bad:
        print("budget: OVER")
        for b in bad:
            print("  - " + b)
        print("  The first move is not to raise a limit. Delete a detector whose "
              "candidates are always dropped, or move a judgement out of the "
              "code and into the report where a reader can see it.")
        return 1
    print("budget: ok")
    return 0


def cmd_subjects(a):
    d = os.path.join(HERE, "subjects")
    for f in sorted(os.listdir(d)):
        if f.endswith(".json"):
            s = json.load(open(os.path.join(d, f)))
            print(f"{s['subject']:24} {s['kind']:10} "
                  f"{len(s['sources'])} source(s)"
                  f"{'  [self]' if s.get('self') else ''}")


def cmd_detectors(a):
    for d in IMPLEMENTED:
        print(f"{d:14} implemented   -- {FAILURE_MODES[d]}")
    for d, why in NOT_IMPLEMENTED.items():
        print(f"{d:14} NOT written   -- {why}")


def main():
    # `prompt` writes more than a screen and is meant to be piped.
    if hasattr(signal, "SIGPIPE"):
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    p = argparse.ArgumentParser(prog="epikrisis", description=__doc__.split("\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True)
    for name, fn, needs in (("subjects", cmd_subjects, False),
                            ("detectors", cmd_detectors, False),
                            ("selftest", cmd_selftest, False),
                            ("budget", cmd_budget, False),
                            ("pin", cmd_pin, True), ("events", cmd_events, True),
                            ("record", cmd_record, True), ("delta", cmd_delta, True),
                            ("prompt", cmd_prompt, True), ("check", cmd_check, True),
                            ("ratio", cmd_ratio, True),
                            ("panel", cmd_panel, True)):
        q = sub.add_parser(name)
        q.set_defaults(fn=fn)
        if needs:
            q.add_argument("subject")
            q.add_argument("--from", dest="frm", default=None,
                           help="directory holding one checkout per source id")
            q.add_argument("--date", default=None)
            q.add_argument("--run", default=None,
                           help="a run stamp, when the newest is not the one "
                                "you mean")
    a = p.parse_args()
    if getattr(a, "frm", None) is None and a.cmd in ("pin", "events", "record",
                                                     "ratio", "panel"):
        raise SystemExit("epikrisis: --from <dir> is required: this reads "
                         "mirrors somebody already has, and never fetches")
    sys.exit(a.fn(a) or 0)


if __name__ == "__main__":
    main()
