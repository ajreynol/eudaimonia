; Expert CPC: finite-field addition is commutative.
; Requires Cpc.eo and expert/CpcExpert.eo; the main signature alone must fail.
(declare-const x (FiniteField 7))
(declare-const y (FiniteField 7))
(assume @neq (not (= (ff.add x y) (ff.add y x))))
(step @eq (= (ff.add x y) (ff.add y x))
  :rule aci_norm_expert :args ((= (ff.add x y) (ff.add y x))))
(step @false false :rule contra :premises (@eq @neq))
