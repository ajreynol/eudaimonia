# Shared dependency checkouts are fetched, never committed. Generated checkers
# keep their compiler dependencies inside their own ignored install/deps/.
/deps/

# Editor scratch files.
.*.kate-swp
*~
__pycache__/

# Lake build artifacts.
.lake/
*.olean
*.ilean
*.trace

# Working space, per the ecosystem's repository policy: transient notes go in
# scratch/, and a document deliberately kept out of git carries the .local.md
# suffix and a line at the top saying why.
scratch/
*.local.md
