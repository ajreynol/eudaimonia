#!/usr/bin/env bash

# Run the checks CI runs. See --help.

set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: scripts/run-ci.sh [GROUP]...

Run the same checks as CI. With no group, runs all of them.

Groups, and whether they run by default:

  build           yes  build the default targets
  modules         yes  every module this project ships must compile
  regress         yes  run test/regress/ and check each verdict
  ethos           yes  cross-check those proofs against the reference checker
  regeneration    yes  check @CALCULUS@/ has not drifted from its signature
  hygiene         no   reject sorry, admit and axiom under @CALCULUS@/

`hygiene` is off by default because a freshly generated checker has one `sorry`
per rule of the signature, so it fails until they are discharged. Run it
explicitly to see the work list, and turn it on for good once the list is
empty:

  scripts/run-ci.sh hygiene

`regeneration` needs install/get-eo-compiler.sh to have been run, and is
skipped with a note when it has not.

Note that no group builds every per-rule proof: that takes hours. A full build
is still the only way to catch a proof broken by a changed rule statement, so
run `scripts/build.sh @CALCULUS@.ApiCorrect` before a release.
USAGE
}

case "${1:-}" in -h|--help) usage; exit 0 ;; esac

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${repo_root}"

# Not named GROUPS: bash keeps that as the current user's group ids and
# silently ignores an assignment to it.
CI_GROUPS=("$@")
# `hygiene` is deliberately not among the defaults: a freshly generated checker
# has one `sorry` per rule, so it would fail from the first commit and a CI that
# is red by construction tells nobody anything. Add it here once the rules are
# discharged -- see docs/development.md.
[ "${#CI_GROUPS[@]}" -gt 0 ] || CI_GROUPS=(build modules regress ethos regeneration)

# Everything this project ships has to compile, `sorry` and all: a `sorry` is a
# warning here, not a build failure, so a red build means something is broken
# rather than unfinished.
#
# @CALCULUS@/Proofs/RuleLemmas.lean and the rule files under Proofs/Rules/ are
# excluded. They are written against names @CALCULUS@/Proofs/RuleSupport/Support.lean
# is meant to supply and does not yet, so they cannot compile until it is
# written -- see docs/development.md.
build_all_modules() {
  local mods
  mods=$(find . -name '*.lean' -not -path './.lake/*' -not -path '*/Rules/*' \
           -not -name 'Main.lean' -not -name 'RuleLemmas.lean' \
         | sed 's|^\./||; s|\.lean$||; s|/|.|g' | sort)
  # shellcheck disable=SC2086
  lake build ${mods}
}

failed=()
run_group() {
  local name="$1"; shift
  echo
  echo "############ ${name} ############"
  if "$@"; then echo "---- ${name}: ok"; else echo "---- ${name}: FAILED"; failed+=("${name}"); fi
}

for g in "${CI_GROUPS[@]}"; do
  case "${g}" in
    build)    run_group build scripts/build.sh ;;
    hygiene)  run_group hygiene scripts/check-proof-hygiene.sh ;;
    modules)  run_group modules build_all_modules ;;
    regress)  run_group regress test/regress/run.sh ;;
    ethos)    run_group ethos scripts/check-with-ethos.sh ;;
    regeneration)
      if [ -f install/deps/eoc-env.sh ]; then
        run_group regeneration install/install-@CALCLOWER@.sh --check
      else
        echo
        echo "############ regeneration ############"
        echo "---- skipped: install/get-eo-compiler.sh has not been run."
      fi ;;
    *) echo "unknown group ${g}" >&2; usage >&2; exit 2 ;;
  esac
done

echo
if [ "${#failed[@]}" -eq 0 ]; then
  echo "==> All groups passed."
else
  echo "==> Failed: ${failed[*]}"
  exit 1
fi
