#!/usr/bin/env bash

# Compile the Eunoia signature of @CALCULUS@ into Lean and install it. See
# --help.

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "${script_dir}/.." && pwd)"
DEPS_DIR="${script_dir}/deps"
DEFS_DIR="${script_dir}/defs"
PACKAGE="@CALCULUS@"
PACKAGE_DIR="${repo_root}/${PACKAGE}"
MINI_PACKAGE="@MINI@"

usage() {
  cat <<'USAGE'
Usage: install/install-@CALCLOWER@.sh [OPTION]... [SIGNATURE]

Compile a Eunoia signature into Lean with ethos-eoc and install what it
publishes into @CALCULUS@/, which is how the modules of that package are
written.

With no SIGNATURE, compiles install/defs/@CALCULUS@.eo -- the signature this
checker is of. Passing one compiles that instead, which is how a signature
being edited elsewhere is tried without copying it here first.

A signature given by path is then *recorded*: it is written to
install/defs/@CALCULUS@.eo as a single self-contained file, with every
(include "...") replaced by the text of the file it names and the comments
dropped. That copy compiles to the same Lean as the original tree, so a later
regeneration needs nothing outside this repository, and a diff of it is a diff
of the calculus. --no-record skips that.

A run that compiles a reduced calculus (--rules) records nothing: what it
compiled is not the signature.

Requires install/get-eo-compiler.sh to have been run once.

Options:
  --semantics PATH     what the symbols of the signature mean
                       (default: install/defs/@CALCULUS@.eos)
  --smt-semantics PATH the SMT-LIB semantics that is written against
                       (default: install/defs/smt.eos)
  --rules R...         compile only these rules, rather than the whole
                       signature. The package is built around only these, so
                       this makes a reduced calculus and not a partial refresh
  --parser             the default; install the generated operator table
  --no-parser          do not install it, leaving @CALCULUS@/Parser.lean as it
                       is. The package then has no parser for this signature
  --mini               install the reduced package @MINI@ instead: the same
                       signature compiled with only the rules named by
                       --rules (or MINI_RULES in this script), and no parser.
                       Nothing about the calculus changes -- it is the same
                       one with fewer rules, which is what makes a proof
                       developed there worth moving to the full package
  --check              install nothing; report whether @CALCULUS@/ is up to
                       date with the signature, exiting 1 if it is not
  --no-record          do not copy a signature given by path into
                       install/defs/, leaving the recorded one as it was
  --jobs N             parallel build jobs
  -h, --help           show this message

What is written, and what is left alone:

  @CALCULUS@/*.lean            signature-wide modules, overwritten every run
                               (except Parser.lean, unless --parser)
  @CALCULUS@/Proofs/RuleLemmas.lean   the rule dispatcher, overwritten
  @CALCULUS@/Proofs/Rules/*.lean      one per rule: written only if absent

Rule files are preserved because the proof lives in the same file as the
generated statement. So a rule new to the signature arrives as a `sorry` stub
to discharge, and a rule whose statement changed keeps its old proof and
therefore fails to build -- which is the intended signal that a proof needs
attention. Build after installing to find them.

Everything hand-written is left alone: @CALCULUS@/Api*.lean,
@CALCULUS@/Diagnostics.lean, and everything under @CALCULUS@/Proofs/ other
than RuleLemmas.lean and Rules/.

Examples:
  install/install-@CALCLOWER@.sh
  install/install-@CALCLOWER@.sh ~/sigs/@CALCULUS@.eo
  install/install-@CALCLOWER@.sh --check
USAGE
}

expand_tilde() {
  case "$1" in
    "~") printf '%s\n' "${HOME}" ;;
    "~/"*) printf '%s\n' "${HOME}/${1#\~/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

SIGNATURE=""
SEMANTICS=""
SMT_SEMANTICS=""
JOBS=""
CHECK=0
RECORD=1
MINI=0
# The rules the reduced package keeps. Chosen when this project was generated;
# edit here to change them, then re-run with --mini.
MINI_RULES="@MINI_RULES@"
# The generated Parser.lean is the operator table of this signature; it plugs
# into the Eunoia library, which this checker has. Installed by default.
NO_PARSER=0
RULES=()
RULES_GIVEN=0

while [ $# -gt 0 ]; do
  case "$1" in
    --semantics) SEMANTICS="${2:?--semantics requires a value}"; shift 2 ;;
    --semantics=*) SEMANTICS="${1#*=}"; shift ;;
    --smt-semantics) SMT_SEMANTICS="${2:?--smt-semantics requires a value}"; shift 2 ;;
    --smt-semantics=*) SMT_SEMANTICS="${1#*=}"; shift ;;
    --jobs) JOBS="${2:?--jobs requires a value}"; shift 2 ;;
    --jobs=*) JOBS="${1#*=}"; shift ;;
    --mini) MINI=1; shift ;;
    --check) CHECK=1; shift ;;
    --no-record) RECORD=0; shift ;;
    --no-parser) NO_PARSER=1; shift ;;
    --parser) NO_PARSER=0; shift ;;
    --rules)
      RULES_GIVEN=1; shift
      while [ $# -gt 0 ] && [ "${1#--}" = "$1" ]; do RULES+=("$1"); shift; done ;;
    -h|--help) usage; exit 0 ;;
    --*) echo "unrecognized option $1" >&2; usage >&2; exit 2 ;;
    *)
      [ -z "${SIGNATURE}" ] || { echo "error: more than one signature given." >&2; exit 2; }
      SIGNATURE="$1"; shift ;;
  esac
done

SIGNATURE="$(expand_tilde "${SIGNATURE}")"
SEMANTICS="$(expand_tilde "${SEMANTICS}")"
SMT_SEMANTICS="$(expand_tilde "${SMT_SEMANTICS}")"

DEFAULT_SIGNATURE="${DEFS_DIR}/@CALCULUS@.eo"
if [ -n "${SIGNATURE}" ]; then SIGNATURE_GIVEN=1; else SIGNATURE_GIVEN=0; fi
SIGNATURE="${SIGNATURE:-${DEFAULT_SIGNATURE}}"

# --mini is this same install with the package renamed, the rule set cut down
# and no parser. The compiler takes the name through --calc-name, so the
# generated modules import each other under it and nothing has to be rewritten.
if [ "${MINI}" = "1" ]; then
  PACKAGE="@MINI@"
  PACKAGE_DIR="${repo_root}/${PACKAGE}"
  NO_PARSER=1
  RECORD=0
  if [ "${RULES_GIVEN}" = "0" ]; then
    if [ -z "${MINI_RULES}" ]; then
      echo "error: --mini needs to know which rules the reduced package keeps," >&2
      echo "and none are set." >&2
      echo >&2
      echo "Name them with --rules, or set MINI_RULES near the top of this" >&2
      echo "script. Pick a handful that exercise the checker rather than the" >&2
      echo "theories: an assumption-discharging rule, a transitivity, a" >&2
      echo "contradiction. scripts/rule-status.sh lists what the signature has." >&2
      exit 2
    fi
    # shellcheck disable=SC2206
    RULES=(${MINI_RULES})
    RULES_GIVEN=1
  fi
fi
SEMANTICS="${SEMANTICS:-${DEFS_DIR}/@CALCULUS@.eos}"
SMT_SEMANTICS="${SMT_SEMANTICS:-${DEFS_DIR}/smt.eos}"

for f in "${SIGNATURE}" "${SEMANTICS}"; do
  [ -f "${f}" ] || { echo "error: ${f} not found." >&2; exit 1; }
done
# The SMT-LIB semantics is the one that may be absent: without it the compiler
# compiles the set it ships with, which is the right default for a calculus
# over ordinary SMT-LIB.
if [ ! -f "${SMT_SEMANTICS}" ]; then
  echo "note: ${SMT_SEMANTICS} not found; using the compiler's own SMT-LIB semantics."
  SMT_SEMANTICS=""
fi

# get-eo-compiler.sh records where it put things, so that is the only place
# this looks for them.
ENV_FILE="${DEPS_DIR}/eoc-env.sh"
[ -f "${ENV_FILE}" ] || {
  echo "error: ${ENV_FILE} not found, so the Eunoia compiler has not been" >&2
  echo "built here yet. Run:" >&2
  echo >&2
  echo "  install/get-eo-compiler.sh" >&2
  exit 1
}
# shellcheck source=/dev/null
. "${ENV_FILE}"

DRIVER="${EOC_DRIVER:?eoc-env.sh did not record EOC_DRIVER}"
[ -f "${DRIVER}" ] || {
  echo "error: ${DRIVER} is gone. Re-run install/get-eo-compiler.sh." >&2
  exit 1
}

if [ "${EOC_DEV_MODE:-0}" = "1" ]; then
  echo "note: the compiler was built in development mode from the head of"
  echo "      ${EOC_ETHOS_BRANCH:-a branch}, so this install is not reproducible."
fi

OUT_DIR="${DEPS_DIR}/eoc-out"
BUILD_DIR="${EOC_BUILD_DIR:-${EOC_ETHOS_DIR}/build-eoc}"
DEST_DIR="${PACKAGE_DIR}"

# --check installs into a throwaway copy and compares, rather than predicting
# what an install would do. Every step below then runs unchanged against that
# copy, so the check cannot drift from the install it is checking.
if [ "${CHECK}" = "1" ]; then
  CHECK_DIR="$(mktemp -d "${TMPDIR:-/tmp}/install-@CALCLOWER@-check.XXXXXX")"
  trap 'rm -rf "${CHECK_DIR}"' EXIT INT TERM
  DEST_DIR="${CHECK_DIR}/${PACKAGE}"
  [ ! -d "${PACKAGE_DIR}" ] || cp -R "${PACKAGE_DIR}" "${DEST_DIR}"
fi

# The signature-wide files the lean subcommand publishes, in the layout of the
# package they are installed into, so one name is both where a file is read and
# where it is written. Per-rule files stand under Proofs/Rules and are handled
# separately. A file the driver writes that is missing from this list is
# silently left behind.
# The compiler names the core checker and term modules after Logos, the checker
# it was written for, and does so regardless of --calc-name: a package compiled
# as `Hello` still gets `Hello.Logos` and `Hello.LogosTerm`. That name is not
# this project's, so both are installed under the checker's own name and the
# imports are rewritten to match. See rename_core below.
EOC_CORE="Logos"

# What the compiler publishes, as `source:destination`. The destination is where
# the module stands in the package, which for the two above is not what the
# compiler called it.
LEAN_OUTPUTS=(
  "${EOC_CORE}.lean:@CHECKER@.lean"
  "${EOC_CORE}Term.lean:@CHECKER@Term.lean"
  "Parser.lean:Parser.lean"
  "SmtEval.lean:SmtEval.lean"
  "SmtModelDefs.lean:SmtModelDefs.lean"
  "SmtValueOrder.lean:SmtValueOrder.lean"
  "SmtModel.lean:SmtModel.lean"
  "Spec.lean:Spec.lean"
  "Proofs/RuleLemmas.lean:Proofs/RuleLemmas.lean"
)

# Point a file's imports at the names this package actually uses.
#
# Two rewrites, and the order matters because both patterns contain `Logos`.
# The calculus-prefixed ones are the core modules and are rewritten first; what
# is left is the parser library, which the compiler also calls Logos and which
# here is named for the format it reads.
rename_core() {
  local file="$1"
  sed -i.bak \
    -e "s/\\b${PACKAGE}\\.${EOC_CORE}Term\\b/${PACKAGE}.@CHECKER@Term/g" \
    -e "s/\\b${PACKAGE}\\.${EOC_CORE}\\b/${PACKAGE}.@CHECKER@/g" \
    -e "s/\\b${EOC_CORE}\\.Parser\\b/@FORMAT@.Parser/g" \
    -e "s/\\b${EOC_CORE}\\.Sexp\\b/@FORMAT@.Sexp/g" \
    "${file}"
  rm -f "${file}.bak"
}

GENERATED_HEADER='-- This file is auto-generated by install/install-@CALCLOWER@.sh, which
-- compiles the Eunoia signature in install/defs/ into Lean.
-- Do not edit. Change the signature, or its semantics, instead.'

# Idempotent, so that a second pass over an installed tree does not stack
# banners. The banner goes ahead of `module`, which Lean allows: comments are
# not commands.
prepend_header() {
  local file="$1" tmp
  case "$(head -n 1 "${file}")" in
    "-- This file is auto-generated by install/install-@CALCLOWER@.sh"*) return 0 ;;
  esac
  tmp="${file}.hdr"
  { printf '%s\n\n' "${GENERATED_HEADER}"; cat "${file}"; } > "${tmp}"
  mv "${tmp}" "${file}"
}

# Where a signature came from, for the header of the copy: the path, and the
# commit if it sits in a git checkout.
signature_location() {
  local dir sha
  dir="$(cd "$(dirname "$1")" && pwd)"
  printf '%s' "$1"
  sha="$(git -C "${dir}" rev-parse HEAD 2>/dev/null)" || { printf '\n'; return 0; }
  if [ -n "$(git -C "${dir}" status --porcelain -- "${dir}" 2>/dev/null)" ]; then
    printf ', at %s with uncommitted changes\n' "${sha}"
  else
    printf ', at %s\n' "${sha}"
  fi
}

# Write the signature $1 to $2 as a single file: every (include "...") replaced
# by the text of the file it names, depth first, each file written only the
# first time it is reached, and every comment dropped. Writing a file once is
# what makes the result equivalent to the original rather than a redeclaration
# of everything the tree shares: ethos also reads a file only the first time it
# is named, see markIncluded in its src/state.cpp. Which lines name a file is
# decided the way driver.py decides it, so the copy holds the files a
# compilation of the original would have read and no others.
flatten_signature() {
  python3 - "$1" "$2" "$(signature_location "$1")" <<'FLATTEN'
import os
import re
import sys

INCLUDE_RE = re.compile(r'^\(include\s+"([^"]+)"\s*\)')
# Anything else that names another file. Splicing cannot represent it, and
# leaving it in place would resolve it against the copy's own directory, so
# stop instead of writing a file that quietly means something else.
UNSPLICEABLE_RE = re.compile(r"^\((include|reference)\b")

HEADER = """\
; Written by install/install-@CALCLOWER@.sh. Do not edit it, and do not read it
; as the upstream signature: it is a copy of one.
;
; It is the Eunoia signature that @CALCULUS@/ was compiled from, written as a
; single file: every (include "...") of the original replaced by the text of
; the file it names, each file appearing once and in the order ethos reads
; them, and the comments of the original dropped. Compiling this produces the
; same Lean as compiling the original tree, so a regeneration needs nothing
; outside this repository.
;
; Read the original for the prose. What is here is what the compiler acts on,
; which is what makes a diff of this file a diff of the calculus.
;
; Read from:
;   %s
;
; Which checkout that was, and at what commit, is deliberately not recorded:
; this file is then a function of the signature and of nothing else, so
; regenerating from another copy of the same calculus leaves it alone rather
; than rewriting a line that says nothing about what it compiles to. The commit
; belongs in the message of whatever commit updates this file.
;
; scripts/run-ci.sh regeneration compiles it and fails if what comes out
; differs from what is committed under @CALCULUS@/, which is what makes a
; generated package that no longer matches its signature visible.
"""


def strip_comments(text):
    """The lines of `text` with every comment removed, and with the lines that
    leaves empty dropped along with the ones that already were.

    A `;` inside a string literal or a |quoted symbol| is content rather than
    the start of a comment, and a line that begins inside either is passed
    through untouched, since its blankness and its trailing spaces are content
    too. `""` is how a string literal spells a quote, so it does not end one.
    """
    lines = []
    line = []
    quote = ""
    quoted_at_start = False
    index = 0
    length = len(text)

    def end_line():
        joined = "".join(line)
        if quoted_at_start or quote:
            lines.append(joined)
        elif joined.strip():
            lines.append(joined.rstrip())

    while index < length:
        char = text[index]
        if char == "\n":
            end_line()
            del line[:]
            quoted_at_start = bool(quote)
            index += 1
            continue
        if not quote:
            if char == ";":
                newline = text.find("\n", index)
                index = length if newline < 0 else newline
                continue
            if char in '"|':
                quote = char
        elif char == quote:
            if char == '"' and text[index + 1 : index + 2] == '"':
                line.append(char)
                index += 1
                char = text[index]
            else:
                quote = ""
        line.append(char)
        index += 1
    end_line()
    if quote:
        sys.exit("error: a %s left open at the end of the file." % quote)
    return lines


source, dest, location = sys.argv[1], sys.argv[2], sys.argv[3]
root = os.path.realpath(source)
base = os.path.dirname(root)
seen = set()
out = []


def name_of(path):
    return os.path.relpath(path, base)


def visit(path, named_by):
    real = os.path.realpath(path)
    if not os.path.isfile(real):
        sys.exit("error: %s includes %s, which is not there." % (named_by, path))
    if real in seen:
        out.append("; (%s is included above)\n" % name_of(real))
        return
    seen.add(real)
    out.append("\n; ==== %s ====\n" % name_of(real))
    with open(real) as handle:
        text = handle.read()
    for line in strip_comments(text):
        command = line.strip()
        match = INCLUDE_RE.match(command)
        if match:
            visit(os.path.join(os.path.dirname(real), match.group(1)), name_of(real))
            continue
        if UNSPLICEABLE_RE.match(command):
            sys.exit("error: %s: cannot splice `%s` into one file." % (name_of(real), command))
        out.append(line + "\n")


visit(root, os.path.basename(root))
with open(dest, "w") as handle:
    handle.write(HEADER % location)
    handle.write("".join(out))
FLATTEN
}

echo "==> Compiling ${SIGNATURE}"
echo "    semantics  ${SEMANTICS}"
[ -z "${SMT_SEMANTICS}" ] || echo "    smt        ${SMT_SEMANTICS}"
echo "    package    ${PACKAGE}"

driver_args=(lean --build-dir "${BUILD_DIR}" --final-out-dir "${OUT_DIR}"
             --semantics "${SEMANTICS}" --calc-name "${PACKAGE}" --skip-cvc5)
[ -z "${SMT_SEMANTICS}" ] || driver_args+=(--smt-semantics "${SMT_SEMANTICS}")
[ -z "${JOBS}" ] || driver_args+=(--jobs "${JOBS}")
[ "${NO_PARSER}" = "0" ] || driver_args+=(--no-parser)
[ ! -x "${BUILD_DIR}/ethos-eoc" ] || driver_args+=(--no-build)
if [ "${RULES_GIVEN}" = "1" ]; then
  [ "${#RULES[@]}" -gt 0 ] || {
    echo "error: --rules was given with no rule names. Drop it to compile the" >&2
    echo "whole signature." >&2
    exit 2
  }
  driver_args+=("${SIGNATURE}" "${RULES[@]}")
else
  driver_args+=(--all "${SIGNATURE}")
fi

python3 "${DRIVER}" "${driver_args[@]}"

LEAN_DIR="${OUT_DIR}/lean"
[ -d "${LEAN_DIR}" ] || {
  echo "error: the compiler published nothing in ${LEAN_DIR}." >&2
  exit 1
}

# The calculus profile.
#
# install/defs/profile.conf records high-level facts about the calculus that
# the documentation and the scaffolding are written against. Several of them
# are visible in what the compiler just emitted, so they are re-checked here: a
# profile that disagrees with the signature is a quiet way for the docs to stop
# being true.
#
# A disagreement is reported, not fatal. The calculus is whatever the signature
# says; what is wrong in that case is the record of it.
# Not for a reduced package: the profile describes the calculus, and a package
# built from a handful of its rules is not it. Checking one against the other
# would report disagreements that are the point of the reduction.
PROFILE_FILE="${DEFS_DIR}/profile.conf"
if [ -f "${PROFILE_FILE}" ] && [ "${MINI}" = "0" ]; then
  # shellcheck source=/dev/null
  . "${PROFILE_FILE}"

  detect() { if eval "$1" >/dev/null 2>&1; then echo yes; else echo no; fi; }

  # A rule that discharges an assumption dispatches through step-pop.
  d_scopes="$(detect "sed -n '/^def __eo_cmd_step_pop_proven/,/^\$/p' '${LEAN_DIR}/@CHECKER@.lean' | grep -q 'CRule\\.'")"
  # A rule with :list premises builds the list through __eo_mk_premise_list.
  d_list="$(detect "grep -q '__eo_mk_premise_list (Term.UOp' '${LEAN_DIR}/@CHECKER@.lean'")"
  # The highest index arity the calculus uses.
  #
  # The compiler emits `UserOp<n>` only for an arity the calculus actually has,
  # so absence is the signal and the highest enum present is the answer. It did
  # not always: an unused arity used to arrive holding a placeholder `| None`,
  # which is why the count below ignores one if it sees it.
  d_idx=0
  for n in 1 2 3; do
    grep -q "^inductive UserOp${n} : Type where" "${LEAN_DIR}/${EOC_CORE}Term.lean" 2>/dev/null || continue
    real="$(sed -n "/^inductive UserOp${n} : Type where/,/^deriving/p" \
      "${LEAN_DIR}/${EOC_CORE}Term.lean" 2>/dev/null \
      | grep -E '^[[:space:]]+[|]' | grep -vc 'None : ' || true)"
    [ "${real:-0}" = "0" ] || d_idx="${n}"
  done

  # The parser is installed unless it was turned off for this run.
  if [ "${NO_PARSER}" = "0" ]; then d_parser=yes; else d_parser=no; fi
  # Logos's SMT-LIB semantics, by digest of the file this compiled against.
  d_logos=no
  if [ -n "${SMT_SEMANTICS}" ] && command -v md5sum >/dev/null 2>&1; then
    [ "$(md5sum < "${SMT_SEMANTICS}" | cut -d' ' -f1)" != "dc24e2490ab4cf6a13e570788b37474b" ] || d_logos=yes
  fi

  echo "==> Checking the calculus profile"
  profile_mismatch=0
  report() {
    local key="$1" declared="$2" detected="$3"
    if [ "${declared}" = "${detected}" ]; then
      printf '    %-16s %-4s\n' "${key}" "${declared}"
    else
      printf '    %-16s %-4s  <- the signature says %s\n' "${key}" "${declared}" "${detected}"
      profile_mismatch=1
    fi
  }
  report scopes        "${PROFILE_SCOPES:-yes}"        "${d_scopes}"
  report list-premises "${PROFILE_LIST_PREMISES:-yes}" "${d_list}"
  report parser        "${PROFILE_PARSER:-yes}"        "${d_parser}"
  report indexed-ops   "${PROFILE_INDEXED_OPS:-3}"     "${d_idx}"
  report logos-smt     "${PROFILE_LOGOS_SMT:-no}"      "${d_logos}"
  # The rest are declared, not derived, and each for the same reason: the
  # machinery is in a fixed eoc template rather than generated from the
  # signature, so a calculus that has the feature and one that does not compile
  # to the same thing. Nothing distinguishes the answers, and nothing is
  # trimmed either way. See TODO in the Eudaimonia roadmap.
  printf '    %-16s %-4s  (declared; eoc emits datatype machinery for every signature)\n' \
    "datatypes" "${PROFILE_DATATYPES:-yes}"
  printf '    %-16s %-4s  (declared; the binder machinery is likewise unconditional)\n' \
    "binders" "${PROFILE_BINDERS:-yes}"
  printf '    %-16s %-4s  (declared; eoc emits the same SmtValueOrder either way)\n' \
    "value-ordering" "${PROFILE_VALUE_ORDERING:-yes}"

  if [ "${profile_mismatch}" = "1" ]; then
    echo
    echo "note: install/defs/profile.conf disagrees with the signature above."
    echo "      The calculus is what the signature says; the record of it is"
    echo "      what is wrong. Edit profile.conf, or regenerate with the right"
    echo "      --[no-]<name> flags. Installing anyway."
  fi
fi

# The signature contract.
#
# What the checker layer needs from the signature, checked against what the
# compiler just emitted rather than against the signature text: the name an
# operator compiles to need not be its spelling, and an attribute is only
# visible in what it generates. Nothing is installed if this fails, so the tree
# is left as it was.
#
# The list is deliberately short, and each entry is here because something
# breaks without it -- not because Logos happens to be written that way. See
# docs/calculus.md.
echo "==> Checking the signature contract"
contract_errors=()

TERM_MODULE="${LEAN_DIR}/${EOC_CORE}Term.lean"
CORE_MODULE="${LEAN_DIR}/${EOC_CORE}.lean"
SPEC_MODULE="${LEAN_DIR}/Spec.lean"

# 1. An operator named `and`.
#
#    The soundness statement is about the conjunction of a proof's assumptions.
#    The checker walks the input problem as `(and F rest)` terminated by `true`
#    and folds its proof stack the same way, naming this operator directly.
if [ -f "${TERM_MODULE}" ] && \
   ! grep -qE "^[[:space:]]*\\|[[:space:]]+and[[:space:]]*:[[:space:]]*UserOp\\b" "${TERM_MODULE}"; then
  contract_errors+=("no operator \`and\`, which the soundness statement is about")
fi

# 2. It means conjunction to the SMT-LIB semantics.
#
#    This is the seam where a mistake would be silent: a signature that
#    declared `and` and translated it to something else would still compile,
#    still check proofs, and the conclusion would be about the wrong formula.
#    Nothing downstream re-checks it, so it is checked here.
if [ -f "${SPEC_MODULE}" ] && \
   ! grep -qE "UserOp\\.and\\).*=> *\\(?SmtTerm\\.and\\b" "${SPEC_MODULE}"; then
  contract_errors+=("the semantics does not send \`and\` to SmtTerm.and")
fi

# 3. `:right-assoc-nil true` -- but only if this calculus actually needs it.
#
#    It is tempting to require the attribute outright. It is not a core
#    requirement: with a plain binary `and` the checker is unchanged -- the
#    assumption chain, the refutation test and the SMT translation are all
#    identical, and the only difference is that the parser stops accepting
#    n-ary `(and a b c)`, which is surface syntax.
#
#    Where it does bite is `:list` premises. A rule gathering its premises with
#    `and` builds the list through `__eo_nil`, and the arm of `__eo_nil` that
#    returns `true` for `and` exists only because of the attribute. Without it
#    every such rule goes Stuck.
#
#    So the requirement is conditional, and both halves are visible in what was
#    just emitted: does anything gather premises with `and`, and is there a nil
#    for it?
if [ -f "${CORE_MODULE}" ]; then
  uses_and_premise_lists=0
  grep -q "__eo_mk_premise_list (Term.UOp UserOp.and)" "${CORE_MODULE}" && uses_and_premise_lists=1
  has_and_nil=0
  grep -qE "UserOp\\.and\\), *T => *\\(?Term\\.Boolean true" "${CORE_MODULE}" && has_and_nil=1
  if [ "${uses_and_premise_lists}" = "1" ] && [ "${has_and_nil}" = "0" ]; then
    contract_errors+=("rules gather \`:list\` premises with \`and\`, but \`and\` is not declared \`:right-assoc-nil true\`, so those rules cannot build a premise list")
  fi
fi

if [ "${#contract_errors[@]}" -gt 0 ]; then
  echo >&2
  echo "error: the signature does not meet the contract the checker relies on:" >&2
  printf '  - %s\n' "${contract_errors[@]}" >&2
  echo >&2
  echo "Declare the operator in install/defs/@CALCULUS@.eo and give it its" >&2
  echo "SMT-LIB meaning in install/defs/@CALCULUS@.eos. A calculus whose rules" >&2
  echo "gather premises with it also needs the nil attribute:" >&2
  echo >&2
  echo "  (declare-const and (-> Bool Bool Bool) :right-assoc-nil true)" >&2
  echo >&2
  echo "Nothing has been installed. See docs/calculus.md." >&2
  exit 1
fi
if [ "${uses_and_premise_lists:-0}" = "1" ]; then
  echo "    ok: \`and\`, translated to SmtTerm.and, with the nil its premise lists need"
else
  echo "    ok: \`and\`, translated to SmtTerm.and"
fi

if [ "${CHECK}" = "1" ]; then
  echo "==> Staging a copy of ${PACKAGE} to compare against"
else
  echo "==> Installing into ${PACKAGE}/"
fi
mkdir -p "${DEST_DIR}/Proofs/Rules"

for pair in "${LEAN_OUTPUTS[@]}"; do
  src="${pair%%:*}"
  name="${pair#*:}"
  # Left alone rather than removed: @CALCULUS@/Api.lean imports it, and the
  # stub that is there parses and compiles, which the generated one would not.
  if [ "${NO_PARSER}" = "1" ] && [ "${name}" = "Parser.lean" ]; then
    continue
  fi
  [ -f "${LEAN_DIR}/${src}" ] || {
    echo "error: ${LEAN_DIR}/${src} was not generated." >&2
    exit 1
  }
  [ "${CHECK}" = "1" ] || echo "    ${PACKAGE}/${name}"
  mkdir -p "$(dirname "${DEST_DIR}/${name}")"
  cp "${LEAN_DIR}/${src}" "${DEST_DIR}/${name}"
  rename_core "${DEST_DIR}/${name}"
  prepend_header "${DEST_DIR}/${name}"
done

written=0
preserved=0
if [ -d "${LEAN_DIR}/Proofs/Rules" ]; then
  shopt -s nullglob
  for file in "${LEAN_DIR}"/Proofs/Rules/*.lean; do
    dest="${DEST_DIR}/Proofs/Rules/$(basename "${file}")"
    if [ -e "${dest}" ]; then preserved=$((preserved + 1)); continue; fi
    cp "${file}" "${dest}"
    rename_core "${dest}"
    written=$((written + 1))
  done
  shopt -u nullglob
  [ "${CHECK}" = "1" ] || \
    echo "    ${PACKAGE}/Proofs/Rules/*.lean (${written} written, ${preserved} preserved)"
fi

if [ "${CHECK}" = "1" ]; then
  updates=0
  while IFS= read -r rel; do
    if [ ! -e "${PACKAGE_DIR}/${rel}" ]; then
      echo "  add     ${PACKAGE}/${rel}"; updates=$((updates + 1))
    elif ! cmp -s "${DEST_DIR}/${rel}" "${PACKAGE_DIR}/${rel}"; then
      echo "  update  ${PACKAGE}/${rel}"; updates=$((updates + 1))
    fi
  done < <(cd "${DEST_DIR}" && find . -type f | sed 's|^\./||' | LC_ALL=C sort)
  if [ "${updates}" -eq 0 ]; then
    echo "==> ${PACKAGE} is up to date with ${SIGNATURE}. Nothing was written."
    exit 0
  fi
  echo "==> ${PACKAGE} is NOT up to date: ${updates} file(s) would change."
  echo "    Nothing was written. Rerun without --check to apply."
  exit 1
fi

# Record what was compiled, so the checker carries its own signature. Only for
# a whole-signature run from a path: --rules compiles a reduced calculus, which
# is not what install/defs/ is a copy of, and a run of the recorded file itself
# has nothing to record.
if [ "${SIGNATURE_GIVEN}" = "1" ] && [ "${RECORD}" = "1" ] && [ "${RULES_GIVEN}" = "0" ]; then
  echo "==> Recording the signature in $(basename "${DEFAULT_SIGNATURE}")"
  tmp_record="${DEFAULT_SIGNATURE}.new"
  flatten_signature "${SIGNATURE}" "${tmp_record}"
  if [ -f "${DEFAULT_SIGNATURE}" ] && cmp -s "${tmp_record}" "${DEFAULT_SIGNATURE}"; then
    rm -f "${tmp_record}"
    echo "    unchanged"
  else
    mv "${tmp_record}" "${DEFAULT_SIGNATURE}"
    echo "    ${DEFAULT_SIGNATURE#"${repo_root}/"}"
  fi
elif [ "${SIGNATURE_GIVEN}" = "1" ] && [ "${RULES_GIVEN}" = "1" ]; then
  echo "==> Not recording the signature: --rules compiled a reduced calculus."
fi

cat <<DONE

==> Done.

Build it with:

  scripts/build.sh

A rule new to the signature arrives as a \`sorry\` stub, and a rule whose
statement changed keeps its old proof and fails to build. Both show up in that
build, and both are proofs needing attention rather than faults in the install.
DONE
