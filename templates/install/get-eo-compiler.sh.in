#!/usr/bin/env bash

# Download and build the Eunoia compiler that install-@CALCLOWER@.sh runs.
# See --help.

set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: install/get-eo-compiler.sh [OPTION]...

Download and build the Eunoia compiler that compiles a signature into Lean: the
Ethos source tree, pinned to the commit in ETHOS_VERSION below, and ethos-eoc
built from the standalone project in its plugins/ directory.

Both go under install/deps/ (see --deps-dir), which is not kept in git, and
the resulting paths are recorded in install/deps/eoc-env.sh, which
install/install-@CALCLOWER@.sh reads so that it only has to be told the
signature.

This sets up the compiler and nothing else. The signature it compiles is
install/defs/@CALCULUS@.eo; run install/install-@CALCLOWER@.sh for that.

The Eunoia compiler is developed on the ethosEoc3 branch of cvc5/ethos, which
is where the latest one is; main lags it and lacks options this template needs.

Which commit of that branch gets built is DEV_MODE in this script. Pinned, it
is the hardcoded ETHOS_VERSION, and what the compiler emits changes only when
someone edits that line. In development mode it is the head of the branch,
resolved at run time -- which tracks the compiler as it is developed, at the
cost of a build that cannot be reproduced later. --tip and --pinned override
DEV_MODE for one run.

DEV_MODE is currently 1, and is meant to be temporary.

Options:
  --deps-dir DIR       where to put everything (default: install/deps)
  --jobs N             parallel compile jobs (default: all processors)
  --keep-tmp           keep the downloaded archive instead of deleting it
  --tip                build the head of the development branch, resolved now
  --pinned             build the recorded commit instead
  -h, --help           show this message

Requires cmake >= 3.12, a C++17 compiler, the GMP development headers
(libgmp-dev on Debian and Ubuntu, gmp on Homebrew), python3, tar, and either
wget or curl.
USAGE
}

# ---------------------------------------------------------------------------
# Which Ethos to build.
#
# The Eunoia compiler is developed on the `ethosEoc3` branch of cvc5/ethos;
# that is where the latest one is. `main` lags it, and its tools/eoc/driver.py
# is missing two options this template is built on:
#
#   --calc-name      what the generated Lean calls the calculus, which is how
#                    the calculus name becomes the user's to choose rather than
#                    being derived from the signature's file name
#   --smt-semantics  the SMT-LIB semantics the calculus is read against, which
#                    is the third of the three files a specification is
#
# So `main` is not an option today: building from it would cost exactly the two
# things that make this a template. Whichever commit is chosen, it is checked
# below rather than assumed.
#
# There are two ways to choose one, and which is in force is DEV_MODE:
#
#   pinned (DEV_MODE=0)  build ETHOS_VERSION. What the compiler emits then
#                        changes only when someone edits that line.
#   tip    (DEV_MODE=1)  resolve the head of ETHOS_BRANCH at run time and build
#                        that. Tracks the compiler as it is developed, at the
#                        cost of two runs a week apart not building the same
#                        thing.
#
# ###########################################################################
# # DEV_MODE IS TEMPORARY. Set it back to 0 -- and set ETHOS_VERSION to the   #
# # commit that was last built -- before this is relied on by anyone else.    #
# # A tip-following build is not reproducible, so a checker generated under   #
# # it cannot be regenerated identically later. See TODO.md.                  #
# ###########################################################################
DEV_MODE=1

ETHOS_BRANCH="ethosEoc3"

# The commit built when DEV_MODE=0. Last known good: the head of ethosEoc3 on
# 2026-08-29. A tip build prints the line to paste here when switching back.
ETHOS_VERSION="1c0f95e17687913eeef9ae6af9efcf2d6fe36076"
# ---------------------------------------------------------------------------

# The driver options the pin has to provide. See the note above.
REQUIRED_DRIVER_OPTIONS=(--calc-name --smt-semantics --semantics --no-parser)

DEPS_DIR=""
JOBS=""
KEEP_TMP=0

expand_tilde() {
  case "$1" in
    "~") printf '%s\n' "${HOME}" ;;
    "~/"*) printf '%s\n' "${HOME}/${1#\~/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

while [ $# -gt 0 ]; do
  case "$1" in
    --deps-dir) DEPS_DIR="${2:?--deps-dir requires a value}"; shift 2 ;;
    --deps-dir=*) DEPS_DIR="${1#*=}"; shift ;;
    --jobs) JOBS="${2:?--jobs requires a value}"; shift 2 ;;
    --jobs=*) JOBS="${1#*=}"; shift ;;
    --keep-tmp) KEEP_TMP=1; shift ;;
    --tip) DEV_MODE=1; shift ;;
    --pinned) DEV_MODE=0; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unrecognized option $1" >&2; usage >&2; exit 2 ;;
  esac
done

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "${script_dir}/.." && pwd)"
DEPS_DIR="$(expand_tilde "${DEPS_DIR}")"
DEPS_DIR="${DEPS_DIR:-${script_dir}/deps}"

if [ -z "${JOBS}" ]; then
  if command -v nproc >/dev/null 2>&1; then JOBS="$(nproc)"
  elif command -v sysctl >/dev/null 2>&1; then JOBS="$(sysctl -n hw.logicalcpu 2>/dev/null || echo 4)"
  else JOBS=4
  fi
fi

for tool in cmake tar python3; do
  command -v "${tool}" >/dev/null 2>&1 || {
    echo "error: ${tool} is required but was not found on PATH." >&2
    exit 1
  }
done

download() {
  if command -v wget >/dev/null 2>&1; then wget -q --show-progress -c -O "$2" "$1"
  elif command -v curl >/dev/null 2>&1; then curl -Lf --progress-bar "$1" -o "$2"
  else
    echo "error: neither wget nor curl is installed; cannot download $1." >&2
    exit 1
  fi
}

TMP_DIR="${DEPS_DIR}/tmp"
ETHOS_DIR="${DEPS_DIR}/ethos"
BUILD_DIR="${ETHOS_DIR}/build-eoc"
mkdir -p "${TMP_DIR}"

# In development mode the commit to build is the head of the branch, resolved
# now. Resolving it to a concrete sha before doing anything else is the point:
# the build is then of one identified commit, which is recorded and reported,
# so a tip build is at least *known* even though it is not reproducible.
if [ "${DEV_MODE}" = "1" ]; then
  command -v git >/dev/null 2>&1 || {
    echo "error: development mode resolves the branch head with git, which was" >&2
    echo "not found on PATH. Use --pinned to build ${ETHOS_VERSION} instead." >&2
    exit 1
  }
  echo "==> Resolving the head of ${ETHOS_BRANCH}"
  RESOLVED="$(git ls-remote https://github.com/cvc5/ethos.git \
              "refs/heads/${ETHOS_BRANCH}" 2>/dev/null | cut -f1)"
  [ -n "${RESOLVED}" ] || {
    echo "error: could not resolve refs/heads/${ETHOS_BRANCH} in cvc5/ethos." >&2
    echo "Check the network, or use --pinned to build ${ETHOS_VERSION}." >&2
    exit 1
  }
  if [ "${RESOLVED}" = "${ETHOS_VERSION}" ]; then
    echo "    ${RESOLVED}"
    echo "    (the same as the recorded commit)"
  else
    echo "    ${RESOLVED}"
    echo "    recorded commit is ${ETHOS_VERSION}, which this run does not build"
  fi
  ETHOS_VERSION="${RESOLVED}"
  cat >&2 <<'WARN'

  ##########################################################################
  ##  DEVELOPMENT MODE: building the branch tip, not a pin.               ##
  ##                                                                      ##
  ##  This build is not reproducible. Two runs on different days build    ##
  ##  different compilers, and a checker generated now cannot be          ##
  ##  regenerated identically later.                                      ##
  ##                                                                      ##
  ##  Temporary. Set DEV_MODE=0 in this script before relying on a build. ##
  ##  on it. The line to paste is printed at the end of this run.         ##
  ##########################################################################

WARN
fi

echo "==> Downloading ethos ${ETHOS_VERSION}"
download "https://github.com/cvc5/ethos/archive/${ETHOS_VERSION}.tar.gz" "${TMP_DIR}/ethos.tgz"
rm -rf "${ETHOS_DIR}"
mkdir -p "${ETHOS_DIR}"
# --strip-components drops the directory a GitHub archive wraps everything in.
tar --strip-components 1 -xzf "${TMP_DIR}/ethos.tgz" -C "${ETHOS_DIR}"

DRIVER="${ETHOS_DIR}/tools/eoc/driver.py"
[ -f "${DRIVER}" ] || {
  echo "error: ${DRIVER} is missing from the ethos tree." >&2
  echo "ETHOS_VERSION is pinned to ${ETHOS_VERSION}, which should contain it." >&2
  exit 1
}

# Check the pin provides what this template compiles with, rather than finding
# out later inside a failed compile. A pin moved to a commit without these --
# to main, for instance -- fails here, naming the option it lacks.
echo "==> Checking the pin provides the options this template needs"
missing=()
for opt in "${REQUIRED_DRIVER_OPTIONS[@]}"; do
  grep -q -- "\"${opt}\"" "${DRIVER}" || missing+=("${opt}")
done
if [ "${#missing[@]}" -gt 0 ]; then
  echo >&2
  echo "error: the pinned ethos does not support: ${missing[*]}" >&2
  echo >&2
  echo "ETHOS_VERSION is ${ETHOS_VERSION}." >&2
  echo "The head of ethos main does not carry --calc-name or --smt-semantics;" >&2
  echo "the ethosEoc3 branch does. See the note above ETHOS_VERSION in this" >&2
  echo "script before moving the pin." >&2
  exit 1
fi
echo "    ok: ${REQUIRED_DRIVER_OPTIONS[*]}"

echo "==> Building ethos-eoc with ${JOBS} jobs"
if ! cmake -S "${ETHOS_DIR}/plugins" -B "${BUILD_DIR}" -DCMAKE_BUILD_TYPE=Release; then
  echo >&2
  echo "error: configuring ethos-eoc failed. It needs cmake >= 3.12, a C++17" >&2
  echo "compiler and the GMP development headers (libgmp-dev on Debian and" >&2
  echo "Ubuntu, gmp on Homebrew)." >&2
  exit 1
fi
cmake --build "${BUILD_DIR}" --parallel "${JOBS}" --target ethos-eoc

ETHOS_EOC="${BUILD_DIR}/ethos-eoc"
[ -x "${ETHOS_EOC}" ] || {
  echo "error: the build reported success but ${ETHOS_EOC} is not there." >&2
  exit 1
}

# The binary stays where it was built on purpose: it resolves its templates
# against the source tree that configured it.

echo "==> Recording what was installed in ${DEPS_DIR}/eoc-env.sh"
cat > "${DEPS_DIR}/eoc-env.sh" <<ENV
# Written by install/get-eo-compiler.sh. Read by install/install-@CALCLOWER@.sh
# so that it only has to be told which signature to compile. Edit by re-running
# get-eo-compiler.sh rather than by hand.
EOC_ETHOS_DIR="${ETHOS_DIR}"
EOC_ETHOS_EOC="${ETHOS_EOC}"
EOC_BUILD_DIR="${BUILD_DIR}"
EOC_DRIVER="${DRIVER}"
EOC_ETHOS_VERSION="${ETHOS_VERSION}"
EOC_ETHOS_BRANCH="${ETHOS_BRANCH}"
# 1 when this was a tip build, so whatever reads this can say that what it is
# working with is not reproducible.
EOC_DEV_MODE="${DEV_MODE}"
ENV

[ "${KEEP_TMP}" = "1" ] || rm -rf "${TMP_DIR}"

cat <<DONE

==> Done.

  ethos      ${ETHOS_DIR} (${ETHOS_VERSION})
  ethos-eoc  ${ETHOS_EOC}
  recorded   ${DEPS_DIR}/eoc-env.sh
DONE

if [ "${DEV_MODE}" = "1" ]; then
  cat <<DONE

==> This was a development build of the ${ETHOS_BRANCH} tip, and is not
    reproducible. To leave development mode, edit install/get-eo-compiler.sh:

      DEV_MODE=0
      ETHOS_VERSION="${ETHOS_VERSION}"

    That pins what was just built, so switching back changes nothing about the
    compiler -- only whether the next run is allowed to move.

    Until then, @CALCULUS@ cannot be regenerated identically from its
    signature, so do not treat a regeneration as reproducible.
DONE
fi
