module

-- **OPEN.** This file is yours: it contains work you have to do, here, and
-- nothing will fill it in. A signature install leaves it alone.
--
-- **Type preservation** — the SMT side.
--
-- A term the semantics gives a type at all has a *well-formed* type. Without
-- this nothing downstream may assume the types it is handed are ones the model
-- can interpret, and every lemma that inspects a type has to re-establish it.
--
-- Could in principle arrive proven: the statement is about the generated
-- `__smtx_typeof` and `__smtx_type_wf`, which come from `smt.eos` — the same
-- for every calculus over ordinary SMT-LIB. It is left open here only because
-- the template does not yet carry the proof.
--
-- What this obligation cost Logos, and what shape the work takes, is in the
-- Logos experience report:
--   https://github.com/ajreynol/eudaimonia/blob/main/docs/logos-experience-report.md
public import @CALCULUS@.ModelWf
import all @CALCULUS@.ModelWf

@[expose] public section

namespace Smtm

/-- A term the semantics types has a well-formed type. -/
theorem smtx_typeof_wf (s : SmtTerm) :
    __smtx_typeof s ≠ SmtType.None ->
    __smtx_type_wf (__smtx_typeof s) = true := by
  sorry

end Smtm
