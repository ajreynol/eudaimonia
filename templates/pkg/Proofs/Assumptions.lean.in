module

-- **FINISHED.** You will not need to edit this file. It is complete as it
-- stands; a signature install leaves it alone, and so does everything else.
--
-- It may still fail to build, if something it *depends on* is open. That is not
-- a defect in this file and not a reason to change it.
--
-- The side conditions of the soundness theorem: the predicates restricting a
-- proof to terms the semantics gives a meaning to, together with the
-- `Decidable` instances that decide them.
--
-- Both roles come from this one file on purpose. What the rule proofs assume
-- and what the executable checks at run time are then a single definition,
-- written down once, so the two cannot drift apart. `Api.lean` reaches them
-- only through `decide`.
--
-- **These are general, not stubs.** Nothing here mentions a rule or an
-- operator of the calculus: a term is translatable when the semantics gives it
-- a type, and a command is when its arguments are. That is why the same file
-- works for any signature.
--
-- Logos has two versions of this. `CpcMini`'s is generic, as here; `Cpc`'s is a
-- 257-line specialization that names 32 individual rules, because some rules
-- need a stronger condition than "the arguments translate" -- and which kind a
-- rule needs is discovered while proving it, not derived from the signature.
-- Expect to strengthen `cmdTranslationOk` per rule as the proofs are written.
-- Logos's own roadmap wants that table generated from the rule files rather
-- than hand-maintained; see `docs/modularity.md` there.
public import @CALCULUS@.Spec
import all @CALCULUS@.Spec
public import @CALCULUS@.@CHECKER@
import all @CALCULUS@.@CHECKER@
public import @CALCULUS@.SmtModel
import all @CALCULUS@.SmtModel

-- `@[expose]`, because the instances below have to reduce where `Api.lean`
-- uses `decide` on them.
@[expose] public section

open Eo
open Smtm

/-- Translating `t` yields a term the SMT-LIB semantics gives a type. -/
def eoHasSmtTranslation (t : Term) : Prop :=
  __smtx_typeof (__eo_to_smt t) ≠ SmtType.None

instance (t : Term) : Decidable (eoHasSmtTranslation t) :=
  inferInstanceAs (Decidable (__smtx_typeof (__eo_to_smt t) ≠ SmtType.None))

/-- Every argument of a checker argument list translates. -/
def cArgListTranslationOk : CArgList -> Prop
  | CArgList.nil => True
  | CArgList.cons a args => eoHasSmtTranslation a ∧ cArgListTranslationOk args

instance : (args : CArgList) -> Decidable (cArgListTranslationOk args)
  | CArgList.nil => .isTrue trivial
  | CArgList.cons _a args =>
    let _ : Decidable (cArgListTranslationOk args) := instDecidableCArgListTranslationOk args
    inferInstanceAs (Decidable (_ ∧ _))

/--
A checker command meets the translation side conditions the rule proofs assume.

Generic: a step is admissible when its arguments translate. A rule needing more
than that is strengthened here, per rule, once its proof says what it needs.
-/
def cmdTranslationOk : CCmd -> Prop
  | CCmd.assume_push A => eoHasSmtTranslation A
  | CCmd.step _ args _ => cArgListTranslationOk args
  | _ => True

instance : (c : CCmd) -> Decidable (cmdTranslationOk c)
  | CCmd.assume_push A => inferInstanceAs (Decidable (eoHasSmtTranslation A))
  | CCmd.step _ args _ => inferInstanceAs (Decidable (cArgListTranslationOk args))
  | CCmd.check_proven _ => .isTrue trivial
  | CCmd.step_pop _ _ _ => .isTrue trivial

/--
Every assumption in the `and`-chain `F` translates: the first hypothesis of
`correct___eo_is_refutation`.

The chain is the one `Api.assumption_term` builds and
`__eo_invoke_assume_list` consumes -- `and` applications terminated by `true` --
so this walks the same shape.
-/
def TranslatableAssumptionList : Term -> Prop
  | Term.Boolean true => True
  | Term.Apply (Term.Apply (Term.UOp UserOp.and) A) rest =>
      eoHasSmtTranslation A ∧ TranslatableAssumptionList rest
  | _ => False

/-- Every command of `pf` satisfies `cmdTranslationOk`: the second hypothesis. -/
def CmdListTranslationOk : CCmdList -> Prop
  | CCmdList.nil => True
  | CCmdList.cons c cs => cmdTranslationOk c ∧ CmdListTranslationOk cs

instance : (cs : CCmdList) -> Decidable (CmdListTranslationOk cs)
  | CCmdList.nil => .isTrue trivial
  | CCmdList.cons _c cs =>
    let _ : Decidable (CmdListTranslationOk cs) := instDecidableCmdListTranslationOk cs
    inferInstanceAs (Decidable (_ ∧ _))
