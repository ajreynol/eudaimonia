module

-- **PROVEN.** Compiles, with no `sorry` of its own. You will not need to edit
-- it; a signature install leaves it alone.
--
-- **Taken verbatim from Logos's CPC proof**, where it is
-- `Cpc/Proofs/TypePreservation/Predicates.lean` -- not restated and not
-- adapted, the same text. It can be, because it depends on nothing but the
-- generated `SmtModel` and so says nothing about CPC in the first place.
--
-- It is one of six files `scripts/check-proof-modularity.sh` holds identical
-- across Logos's two packages, which are built from the same signature with
-- different rule sets -- so the property is tested there rather than assumed.
-- Verified here against a signature that is not CPC.

public import @CALCULUS@.SmtModel
import all @CALCULUS@.SmtModel

public section

open SmtEval
open Smtm

namespace Smtm

/-- Semantic inhabitation of an SMT type. -/
def type_inhabited (T : SmtType) : Prop :=
  ∃ v : SmtValue, __smtx_typeof_value v = T

/-- Proof-facing canonicality predicate for SMT values. -/
def value_canonical (v : SmtValue) : Prop :=
  __smtx_value_canonical v = true

end Smtm
