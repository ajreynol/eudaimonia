module

-- **Fixed (F).** Copied in complete by the generator: hand-written, but by the
-- template rather than by you. A signature install leaves it alone, and so does
-- everything else, so an edit here survives -- there is just no reason to make
-- one unless you want to change what the checker does.
--
-- That each check `Api.lean` runs really is the component of
-- `correct___eo_is_refutation` it stands for.
--
-- This is the layer that lets the executable be written for speed without the
-- theorem quietly becoming about something else. `check_refutation` folds over
-- the parser\'s list in constant stack, where the theorem is stated about a
-- recursion over the corresponding `and`-chain; `invoke_assume_list_eq_fold`
-- below is what makes those the same run.
--
-- These are proven. They are about the plumbing -- folds, guards and `decide`
-- -- rather than about the calculus, so they hold whatever the signature is,
-- and nothing here needs revisiting when the rules are written.
--
-- The two side-condition lemmas are trivial only because
-- `Proofs/Assumptions.lean` currently defines those conditions as `True`.
-- Replacing the stubs there is what gives them content; the statements below
-- do not change.
--
-- In Logos: `Cpc/ApiChecks.lean`.
public import @CALCULUS@.Api
import all @CALCULUS@.Api
public import @CALCULUS@.Proofs.Assumptions
import all @CALCULUS@.Proofs.Assumptions

public section

namespace Eo

/--
Consuming a chain built by `assumption_chain_step` is folding the guarded push
over the list it was built from.

Induction on the list, generalised over the state and the seed of the chain,
which is what makes the step go through: one `assumption_chain_step` on the
right of the chain is one `invoke_input_assume` on the state.
-/
private theorem invoke_assume_list_foldl (assums : List Term) :
    ∀ (s : CState) (F : Term),
      __eo_invoke_assume_list s (assums.foldl assumption_chain_step F)
        = assums.foldl invoke_input_assume (__eo_invoke_assume_list s F) := by
  induction assums with
  | nil => intro s F; rfl
  | cons A rest ih =>
    intro s F
    show __eo_invoke_assume_list s (rest.foldl assumption_chain_step (assumption_chain_step F A))
      = rest.foldl invoke_input_assume (invoke_input_assume (__eo_invoke_assume_list s F) A)
    rw [ih]
    rfl

/--
Folding the guarded push over the parser\'s list builds the same state as
`__eo_invoke_assume_list` on the corresponding `and`-chain.

This is what licenses the fold in `check_refutation`: the executable walks a
list in constant stack, the theorem talks about a recursion over a chain, and
this says the two are the same run.
-/
theorem invoke_assume_list_eq_fold (assums : List Term) :
    assums.foldl invoke_input_assume checker_init_state
      = __eo_invoke_assume_list CState.nil (assumption_term assums) := by
  show assums.foldl invoke_input_assume CState.nil
    = __eo_invoke_assume_list CState.nil (assums.foldl assumption_chain_step (Term.Boolean true))
  rw [invoke_assume_list_foldl]
  rfl

/-- What the executable computes is what the checker\'s own refutation test does. -/
theorem check_refutation_eq_checker (assums : List Term) (cmds : CCmdList) :
    check_refutation assums cmds
      = __eo_checker_is_refutation (assumption_term assums) cmds := by
  show __eo_state_is_refutation
        (__eo_invoke_cmd_list (assums.foldl invoke_input_assume checker_init_state) cmds)
    = __eo_state_is_refutation
        (__eo_invoke_cmd_list (__eo_invoke_assume_list CState.nil (assumption_term assums)) cmds)
  rw [invoke_assume_list_eq_fold]

/-- `check_refutation` returning `true` is `eo_is_refutation` of the same terms. -/
theorem refutation_of_check (assums : List Term) (cmds : CCmdList) :
    check_refutation assums cmds = true ->
    eo_is_refutation (assumption_term assums) cmds := by
  intro h
  refine eo_is_refutation.intro _ _ ?_
  rw [← check_refutation_eq_checker]
  exact h

/--
The second side condition, from its check.

`decide` on the predicate of `Proofs/Assumptions.lean`, so this is just
`of_decide_eq_true`. It stays that way however that predicate is strengthened,
which is the point of deciding it there rather than reimplementing it here.
-/
theorem cmdListTranslationOk_of_check (cmds : CCmdList) :
    check_cmdListTranslationOk cmds = true ->
    CmdListTranslationOk cmds := by
  intro h
  exact of_decide_eq_true h

/--
Translatability is carried along the chain as it is folded.

Generalised over the seed, which is what makes the step go through: one
`assumption_chain_step` adds one `and` link, and `TranslatableAssumptionList` of
that link is exactly the conjunct for the new assumption together with the rest.
-/
private theorem translatable_foldl (assums : List Term) :
    ∀ F : Term, TranslatableAssumptionList F ->
      (∀ A ∈ assums, eoHasSmtTranslation A) ->
      TranslatableAssumptionList (assums.foldl assumption_chain_step F) := by
  induction assums with
  | nil => intro F hF _; exact hF
  | cons A rest ih =>
    intro F hF hall
    refine ih (assumption_chain_step F A) ?_ ?_
    · exact ⟨hall A (List.mem_cons_self ..), hF⟩
    · intro B hB; exact hall B (List.mem_cons_of_mem A hB)

/--
The first side condition, from its check.

The executable checks each assumption in the parser's list; the theorem is
stated about the chain those are folded into. This carries one to the other.
-/
theorem translatableAssumptionList_of_check (assums : List Term) :
    check_translatableAssumptions assums = true ->
    TranslatableAssumptionList (assumption_term assums) := by
  intro h
  refine translatable_foldl assums (Term.Boolean true) trivial ?_
  intro A hA
  exact of_decide_eq_true (List.all_eq_true.mp h A hA)

/-! ## Reading the checks back out of a `correct` verdict

`verdict` reports `correct` only when all three passed, so a `correct` run
yields each of them. These are what `ApiCorrect.lean` applies.
-/

private theorem verdict_correct_of_check_proof {input : String}
    {assums : List Term} {cmds : CCmdList}
    (hParse : parseProof input = Except.ok (assums, cmds))
    (hCorrect : check_proof input = Except.ok Verdict.correct) :
    verdict assums cmds = Verdict.correct := by
  unfold check_proof at hCorrect
  rw [hParse] at hCorrect
  exact Except.ok.inj hCorrect

theorem check_refutation_of_correct {input : String}
    {assums : List Term} {cmds : CCmdList}
    (hParse : parseProof input = Except.ok (assums, cmds))
    (hCorrect : check_proof input = Except.ok Verdict.correct) :
    check_refutation assums cmds = true := by
  have h := verdict_correct_of_check_proof hParse hCorrect
  unfold verdict at h
  by_cases hr : check_refutation assums cmds = true
  · exact hr
  · simp [hr] at h

theorem check_translatableAssumptions_of_correct {input : String}
    {assums : List Term} {cmds : CCmdList}
    (hParse : parseProof input = Except.ok (assums, cmds))
    (hCorrect : check_proof input = Except.ok Verdict.correct) :
    check_translatableAssumptions assums = true := by
  have h := verdict_correct_of_check_proof hParse hCorrect
  unfold verdict at h
  by_cases ht : check_translatableAssumptions assums = true
  · exact ht
  · by_cases hr : check_refutation assums cmds = true <;> simp [hr, ht] at h

theorem check_cmdListTranslationOk_of_correct {input : String}
    {assums : List Term} {cmds : CCmdList}
    (hParse : parseProof input = Except.ok (assums, cmds))
    (hCorrect : check_proof input = Except.ok Verdict.correct) :
    check_cmdListTranslationOk cmds = true := by
  have h := verdict_correct_of_check_proof hParse hCorrect
  unfold verdict at h
  by_cases hc : check_cmdListTranslationOk cmds = true
  · exact hc
  · by_cases hr : check_refutation assums cmds = true <;>
      by_cases ht : check_translatableAssumptions assums = true <;>
      simp [hr, ht, hc] at h

end Eo
