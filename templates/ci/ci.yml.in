name: CI

on:
  push:
    branches: [main]
  pull_request:

jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Install Lean
        run: |
          curl -sSfL https://github.com/leanprover/elan/releases/latest/download/elan-x86_64-unknown-linux-gnu.tar.gz | tar xz
          ./elan-init -y --default-toolchain none
          echo "$HOME/.elan/bin" >> "$GITHUB_PATH"

      # Builds the library and the executable, not the per-rule proofs: those
      # take hours. A full build is still the only way to catch a proof broken
      # by a changed rule statement, so run it before a release.
      - name: Build
        run: scripts/build.sh

      # Textual, builds nothing. This is what stops an unproven rule landing
      # silently given that CI does not build every proof. Expected to fail
      # while rules are still stubs -- drop continue-on-error once they are not.
      - name: Proof hygiene
        continue-on-error: true
        run: scripts/check-proof-hygiene.sh

      # Needs the Eunoia compiler, which is a C++ build; enable once the
      # signature is settled and the cost is worth it.
      #
      # - name: Regeneration
      #   run: |
      #     install/get-eo-compiler.sh
      #     install/install-@CALCLOWER@.sh --check
