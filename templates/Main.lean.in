import @CALCULUS@

/-!
The `@EXE@` executable: read a proof in the `@CALCULUS@` calculus and report
whether it is a refutation.

The checking itself is not written yet -- it is what the Eunoia signature in
`signature/` compiles to. This file is the shape of the driver: read the one
path given, hand the text to the checker, and turn the verdict into an exit
status. The convention the verdicts follow is Logos's:

| output       | status | meaning                                              |
| ------------ | ------ | ---------------------------------------------------- |
| `correct`    | 0      | the proof's assumptions are unsatisfiable            |
| `incorrect`  | 1      | the proof is not accepted as a refutation            |
| `incomplete` | 2      | accepted, but outside what the semantics models      |
-/

def usage : String :=
  s!"usage: @EXE@ <proof>\n\n\
     Check a proof in the {@CALCULUS@.calculusName} calculus."

def main : List String → IO UInt32
  | [path] => do
    let _input ← IO.FS.readFile path
    IO.eprintln s!"@EXE@: no calculus is installed yet, so {path} cannot be checked."
    IO.eprintln "Compile a Eunoia signature into signature/ and replace \
                 @CALCULUS@.Basic with what it produces."
    return 1
  | _ => do
    IO.eprintln usage
    return 1
