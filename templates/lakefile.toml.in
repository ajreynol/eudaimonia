name = "@CHECKER@"
version = "0.1.0"
defaultTargets = ["Eunoia", "@CALCULUS@", "@EXE@"]

# Reading the Eunoia proof format: the s-expression reader and the table-driven
# proof parser. Independent of the calculus -- @CALCULUS@/Parser.lean is the
# operator table it reads, and that is what is generated from the signature.
[[lean_lib]]
name = "Eunoia"

# The calculus: the proof rules, the terms they are stated about, and the
# semantics they are proven correct against. The modules compiled from
# signature/@CALCULUS@.eo belong here.
[[lean_lib]]
name = "@CALCULUS@"
moreLeanArgs = ["-DwarningAsError=true"]

@MINI_LIB@# The checker: the executable that reads a proof and reports a verdict.
[[lean_exe]]
name = "@EXE@"
root = "Main"
