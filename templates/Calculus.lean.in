module

-- The root of the `@CALCULUS@` library: the calculus `@CHECKER@` checks proofs in.
--
-- This module exists to import the rest of the library, so that
-- `lake build @CALCULUS@` builds all of it. The modules compiled from
-- `signature/@CALCULUS@.eo` are added to the imports below as they arrive;
-- `@CALCULUS@.Basic` is the placeholder they replace.
--
-- The comments here are `--` rather than a `/-! -/` module docstring on
-- purpose: a docstring is a command, so it would end the import section and
-- the imports below it would not parse.
public import @CALCULUS@.Basic
import all @CALCULUS@.Basic

public section
