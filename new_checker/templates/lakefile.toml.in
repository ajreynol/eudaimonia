name = "@CHECKER@"
version = "0.1.0"
defaultTargets = ["@FORMAT@", "@CALCULUS@", "@EXE@"]

# Reading the input proof format: the s-expression reader and the table-driven
# proof parser. Independent of the calculus -- @CALCULUS@/Parser.lean is the
# operator table it reads, and that is what is generated from the signature.
[[lean_lib]]
name = "@FORMAT@"

# The calculus: the proof rules, the terms they are stated about, and the
# semantics they are proven correct against. The modules compiled from
# signature/@CALCULUS@.eo belong here.
# `warningAsError` is deliberately not set. A `sorry` is a warning, and this
# package is meant to compile with them: everything ships in a shape that
# builds, and what is unproven is reported by scripts/check-proof-hygiene.sh
# rather than by a failed build. See "Compiles, proven, open" in README.md.
[[lean_lib]]
name = "@CALCULUS@"

@MINI_LIB@# The checker: the executable that reads a proof and reports a verdict.
[[lean_exe]]
name = "@EXE@"
root = "Main"
