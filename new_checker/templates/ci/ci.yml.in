name: CI

on:
  push:
    branches: [main]
  pull_request:

jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Install Lean
        run: |
          curl -sSfL https://github.com/leanprover/elan/releases/latest/download/elan-x86_64-unknown-linux-gnu.tar.gz | tar xz
          ./elan-init -y --default-toolchain none
          echo "$HOME/.elan/bin" >> "$GITHUB_PATH"

      # Builds the library and the executable, not the per-rule proofs: those
      # take hours. A full build is still the only way to catch a proof broken
      # by a changed rule statement, so run it before a release.
      - name: Build
        run: scripts/build.sh

      # Proof hygiene is deliberately not run yet.
      #
      # `scripts/check-proof-hygiene.sh` rejects `sorry`, `admit` and `axiom`
      # textually, without building. That is what stops an unproven rule
      # landing silently, given that CI does not build every proof -- so it is
      # worth turning on, and worth turning on early.
      #
      # It cannot run from the first commit: a freshly generated checker has
      # one `sorry` per rule of the signature, plus the soundness theorem in
      # @CALCULUS@/Proofs/Checker.lean, so it would fail every build. A CI that
      # is red by construction is one nobody reads.
      #
      # TO ENABLE, once the rule proofs are discharged: uncomment the step
      # below, and add `hygiene` to the default groups in scripts/run-ci.sh.
      # Run `scripts/run-ci.sh hygiene` meanwhile to see what is left.
      #
      # - name: Proof hygiene
      #   run: scripts/check-proof-hygiene.sh

      # Needs the Eunoia compiler, which is a C++ build; enable once the
      # signature is settled and the cost is worth it.
      #
      # - name: Regeneration
      #   run: |
      #     install/get-eo-compiler.sh
      #     install/install-@CALCLOWER@.sh --check
